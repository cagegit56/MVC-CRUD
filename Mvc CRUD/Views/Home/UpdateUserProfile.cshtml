@model Mvc_CRUD.Dto.UserProfileDTO;

@{
    ViewData["Title"] = "Profile";  
}

<link href="~/images" />
<link href="~/css/site.css" rel="stylesheet"/>

<div class="container py-4">
        <div class="position-relative">
            <div class="dropdown">
                <button type="button" id="toggleCoverPicOptions" style="background:none; border:none; padding:0; cursor:pointer; display:block; width:100%;">
                    @if(Model.UserCoverPicUrl != null || Model.UserCoverPicUrl?.Length > 0)
                    {
                        <img src="@Model.UserCoverPicUrl" id="bgImage" class="img-fluid w-100" style="height: 450px; object-fit: cover; cursor : pointer;" alt="Cover Image">
                    }
                    else
                    {
                        <div class="bg-secondary w-100" id="letterCoverPic" style="height: 450px; cursor : pointer; align-content : center;">
                            <div class="text-capitalize text-white fw-bolder h1">@(char.ToUpper(@Model.UserName[0]) + @Model.UserName.Substring(1)) </div>
                            <div> <small class="text-white h4">Add a Cover Picture</small> </div>
                        </div>   
                        <div id="updatedCoverPic"></div>
                    }
                    <div id="removedCoverPic"></div>
                </button>
                <button class="btn btn-primary position-absolute end-0" type="button" id="btnToggleCoverPicOptions" style="bottom: 0; right: 0;">
                    <i class="bi bi-camera"></i> Edit Cover Photo
                </button>
                <ul class="custom-menu" id="coverPicDropDownMenu">
                    <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#viewCoverPic">View Cover Photo</a> </li>
                    <li><label class="dropdown-item" style="cursor : pointer">Change Cover Photo
                        <input type="file" id="coverPicInput" data-action="UpdateCoverPic" accept="image/*" class="d-none"></label>   
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" data-action="RemoveCoverPic" href="#">Remove Cover Photo</a></li>
                </ul>
            </div>
            <div class="position-absolute"
                 style="bottom: -70px; left: 30px; z-index : 1;">
                <div class="dropdown">
                    <button id="toggleProfileDropDown" class="rounded-circle" type="button" style="background:none; border:none; padding:0; cursor:pointer; display:block; width:100%;">
                       @if (Model.UserProfilePicUrl != null && Model.UserProfilePicUrl.Length > 0)
                       {
                           <img src="@Model.UserProfilePicUrl" id="profileImg" class="rounded-circle border border-4 border-white profile-pic-phone-width"
                                    style="width: 150px; height: 150px; min-width : 110px; min-height : 110px; object-fit: cover; cursor : pointer" />
                       }
                       else
                       {
                           <div id="letterProfilePic" class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center text-capitalize fw-bolder h2 profile-pic-phone-width'
                                style='width:150px; height:150px; min-width:50px; min-height:50px;'>
                                @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "XX")
                           </div>
                           <div id="updatedProfilePic"></div>
                       } 
                       <div id="removedProfilePic"></div>
                       <div class="camera-icon">
                           <i class="bi bi-camera-fill"></i>
                       </div>
                    </button>
                    <ul class="custom-profile-pic-dropdown" id="profileDropDownMenu">
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#viewProfilePic">View Profile Picture</a> </li>
                        <li><label class="dropdown-item" style="cursor : pointer">Change Profile Picture
                            <input type="file" id="profilePicInput" data-action="UpdateProfilePic" accept="image/*" class="d-none"></label>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" data-action="RemoveProfilePic" href="#">Remove Profile Picture</a></li>
                    </ul>
                </div>
            </div>          
        </div>
        <div class="d-flex justify-content-between flex-wrap align-items-center">
        <div style="padding-left: 11.5rem">
            <h2 class="fw-bold mb-0">@(char.ToUpper(@Model.UserName[0]) + @Model.UserName.Substring(1)) @(char.ToUpper(@Model.LastName[0]) + @Model.LastName.Substring(1))</h2>
            <small class="text-muted">1,245 Friends</small>
        </div>
        </div>
        <hr />
        <ul class="nav nav-tabs mt-3" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#About">About</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#Education">Education</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#Career">Career</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#Location">Location</button>
            </li>
        </ul> 

        <div class="tab-content mt-4">
            <div class="tab-pane fade show active" id="About">
                <form asp-controller="Home" asp-action="UpdateUserProfile" method="post" data-action="UpdateUserProfileForm">
                    <div class="card shadow-sm border-0 rounded-4 mb-1 w-100">
                        <div class="card-body">
                            <h5 class="fw-bold">About</h5>
                            <a class="nav-link fw-bolder h5 edit-label-ending" data-action="EditBio" style="cursor: pointer;" >
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <div class="d-flex mt-5 align-items-center">                              
                                <div>
                                     <div>
                                         <i class="bi text-primary bi-person-lines-fill"></i> 
                                         <strong>Bio:</strong> 
                                     </div>
                                     <span class="text-muted fw-bold preserve-lines @(string.IsNullOrWhiteSpace(Model.Bio) ? "" : "ms-3")" data-group="labelAboutInfo" id="labelBio">@Model.Bio</span>
                                </div>  
                            </div>
                            <div class="floating-textArea d-none mt-3" data-group="aboutInfo">
                                <textarea class="form-control" name="Bio" rows="3" placeholder=" ">@Model.Bio</textarea>
                                <label for="bio" class="text-muted">@(!string.IsNullOrEmpty(Model.Bio) ? "" : "Write a short bio...")</label>
                            </div> 
                            <p class="mt-2 mb-2">  
                                <i class="bi bi-people-fill text-primary"></i> <strong>RelationShip Status:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.RelationShipStatus) ? "" : "ms-3")" data-group="labelAboutInfo" id="labelRelationStatus">
                                    @Model.RelationShipStatus
                                </span>
                            </p>
                            <div class="floating-input d-none mt-3" data-group="aboutInfo">
                                <input type="text" class="form-control" list="comboboxOptions" name="RelationShipStatus" value="@Model.RelationShipStatus" maxlength="30" autocomplete="off" placeholder=" ">
                                <label for="relationStatus" class="text-muted">@(!string.IsNullOrEmpty(Model.RelationShipStatus) ? "" : "Select your relationship status...")</label>
                            </div>                        
                            <datalist id="comboboxOptions">
                                <option value="In a RelationShip">In a RelationShip</option>
                                <option value="Single">Single</option>
                                <option value="Divorced">Divorced</option>
                                <option value="Married">Married</option>
                                <option value="Complicated">Complicated</option>
                            </datalist>                        
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-geo-alt-fill text-primary"></i> <strong>Location:</strong> <br />
                                <span class="text-muted fw-bold mb-1 @(string.IsNullOrWhiteSpace(Model.Bio) ? "" : "ms-3")" data-group="labelAboutInfo" id="labelLocation">
                                    @Model.Location
                                </span>
                            </p>
                            <div class="floating-input d-none mt-3" data-group="aboutInfo">
                                <input type="text" class="form-control" name="Location" value="@Model.Location" placeholder=" "/>
                                <label for="location" class="text-muted">@(!string.IsNullOrEmpty(Model.Location) ? "" : "Enter your location...")</label>
                            </div>                       
                            <div class="d-flex align-items-center mt-2 gap-1">
                                <button type="button" class="btn btn-secondary mt-2 mb-1 d-none" id="cancelBtn" data-group="aboutInfo"> Cancel</button>
                                <button type="submit" class="btn btn-primary mt-2 mb-1 d-none" id="saveBtn" data-group="aboutInfo">Save Changes</button>
                                <a id="EducationTab" href="#" class="ms-auto text-decoration-none d-flex flex-column align-items-center lh-1">
                                    <i class="bi bi-arrow-right fs-1"></i> <small>Continue</small>
                                </a>
                            </div>
                            <input name="tabInfo" value="aboutForm" hidden/>
                        </div>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="Education">
                <div class="card shadow-sm border-0 rounded-4 mb-4 w-100">
                    <form asp-controller="Home" asp-action="UpdateUserProfile" method="post" data-action="UpdateUserProfileForm">
                        <div class="card-body">
                            <h5 class="fw-bold">Education</h5>
                            <a class="nav-link fw-bolder h5 edit-label-ending" id="editEducationBtn" data-action="EditEducation" style="cursor : pointer;">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <div class="d-flex mt-5 justify-content-between">
                                <div>
                                    <div>
                                        <i class="bi bi-mortarboard-fill text-primary"></i> 
                                        <strong>University/College:</strong>
                                    </div>
                                    <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.CollegeName) ? "" : "ms-3")" data-group="labelEducationInfo" id="labelCollegeName">
                                        @Model.CollegeName
                                    </span>
                                </div>                               
                            </div>
                            <div class="floating-input mt-3 d-none" data-group="educationInfo">
                                <input type="text" class="form-control" name="CollegeName" value="@Model.CollegeName" placeholder=" "/>
                                <label for="collegeName" class="text-muted">@(!string.IsNullOrEmpty(Model.CollegeName) ? "" : "Enter your college name...")</label>
                            </div>                    
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-journal-bookmark-fill text-primary"></i> <strong>Course:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.Course) ? "" : "ms-3")" data-group="labelEducationInfo" id="labelCourse">
                                    @Model.Course
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="educationInfo">
                                <input type="text" class="form-control" name="Course" value="@Model.Course" placeholder=" "/>
                                <label for="course" class="text-muted">@(!string.IsNullOrEmpty(Model.Course) ? "" : "Enter your course...")</label>
                            </div>                    
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-clock-history text-primary"></i> <strong>Period:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.CollegePeriod) ? "" : "ms-3")" data-group="labelEducationInfo" id="labelCollegePeriod">
                                    @Model.CollegePeriod
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="educationInfo">
                                <input type="text" class="form-control" name="CollegePeriod" value="@Model.CollegePeriod" placeholder=" "/>
                                <label for="collegePeriod" class="text-muted">@(!string.IsNullOrEmpty(Model.CollegePeriod) ? "" : "example..2025-2026")</label>
                            </div>                    
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-building text-primary"></i> <strong>High School Name:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.HighSchoolName) ? "" : "ms-3")" data-group="labelEducationInfo" id="labelHighSchoolName">
                                    @Model.HighSchoolName
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="educationInfo">
                                <input type="text" class="form-control" name="HighSchoolName" value="@Model.HighSchoolName" placeholder=" "/>
                                <label for="schoolName" class="text-muted">@(!string.IsNullOrEmpty(Model.HighSchoolName) ? "" : "Enter your high school name...")</label>
                            </div>                    
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-collection text-primary"></i> <strong>Subject:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.Subject) ? "" : "ms-3")" data-group="labelEducationInfo" id="labelSubject">
                                    @Model.Subject
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="educationInfo">
                                <input type="text" class="form-control" name="Subject" value="@Model.Subject" placeholder=" "/>
                                <label for="subject" class="text-muted">@(!string.IsNullOrEmpty(Model.Subject) ? "" : "Enter your subject...")</label>
                            </div>                    
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-clock-history text-primary"></i> <strong>Period:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.SchoolPeriod) ? "" : "ms-3")" data-group="labelEducationInfo" id="labelSchoolPeriod">
                                    @Model.SchoolPeriod
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="educationInfo">
                                <input type="text" class="form-control" name="SchoolPeriod" value="@Model.SchoolPeriod" placeholder=" " />
                                <label for="schoolPeriod" class="text-muted">@(!string.IsNullOrEmpty(Model.SchoolPeriod) ? "" : "example...2010-2022")</label>
                            </div>                    
                            <div class="d-flex align-items-center mt-2 gap-1">
                                <button type="button" class="btn btn-secondary mt-2 mb-1 d-none" id="educationCancel" data-group="educationInfo">Cancel</button>
                                <button type="submit" class="btn btn-primary mt-2 mb-1 d-none" id="educationSave" data-group="educationInfo">Save Changes</button>
                                <a id="CareerTab" data-action="CareerToEducationTab" href="#" class="ms-auto text-decoration-none d-flex flex-column align-items-center lh-1">
                                    <i class="bi bi-arrow-right fs-1"></i> <small>Continue</small>
                                </a>
                            </div> 
                            <input name="tabInfo" value="educationForm" hidden/>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade" id="Career">
                <div class="card shadow-sm border-0 rounded-4 mb-4 w-100">
                    <form asp-controller="Home" asp-action="UpdateUserProfile" method="post" data-action="UpdateUserProfileForm">
                        <div class="card-body">
                            <h5 class="fw-bold">Career</h5>
                            <a class="nav-link fw-bolder h5 edit-label-ending" data-action="EditCareer" style="cursor: pointer;">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <div class="d-flex mt-5 justify-content-between">
                                <div> 
                                    <div>
                                        <i class="bi bi-briefcase-fill text-primary"></i> 
                                        <strong>Job Title:</strong>
                                    </div>
                                    <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.JobTitle) ? "" : "ms-3")" data-group="labelCareerInfo" id="labelJobTitle">
                                        @Model.JobTitle
                                    </span>
                                </div>                                
                            </div>
                            <div class="floating-input mt-3 d-none" data-group="careerInfo">
                                <input type="text" class="form-control" name="JobTitle" value="@Model.JobTitle" placeholder=" "/>
                                <label for="jobTitle" class="text-muted">@(!string.IsNullOrEmpty(Model.JobTitle) ? "" : "Enter your job title...")</label>
                            </div>                        
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-building text-primary"></i> <strong>Industry:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.Industry) ? "" : "ms-3")" data-group="labelCareerInfo" id="labelIndustry">
                                    @Model.Industry
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="careerInfo">
                                <input type="text" class="form-control" name="Industry" value="@Model.Industry" placeholder=" "/>
                                <label for="industry" class="text-muted">@(!string.IsNullOrEmpty(Model.Industry) ? "" : "Enter your industry...")</label>
                            </div>                        
                            <p class="mt-2 mb-2"> 
                                <i class="bi bi-clock-history text-primary"></i> <strong>Period:</strong> <br />
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.JobPeriod) ? "" : "ms-3")" data-group="labelCareerInfo" id="labelJobPeriod">
                                    @Model.JobPeriod
                                </span>
                            </p>
                            <div class="floating-input mt-3 d-none" data-group="careerInfo">
                                <input type="text" class="form-control" name="JobPeriod" value="@Model.JobPeriod" placeholder=" "/>
                                <label for="jobPeriod" class="text-muted">@(!string.IsNullOrEmpty(Model.JobPeriod) ? "" : "example...2020-2026")</label>
                            </div>                        
                            <div class="d-flex align-items-center mt-2 gap-1">
                                <button type="button" class="btn btn-secondary mt-2 mb-1 d-none" id="careerCancel" data-group="careerInfo">Cancel</button>
                                <button type="submit" class="btn btn-primary mt-2 mb-1 d-none" id="careerSave" data-group="careerInfo">Save Changes</button>
                                <a id="LocationTab" data-action="LocationToEducationTab" href="#" class="ms-auto text-decoration-none d-flex flex-column align-items-center lh-1">
                                    <i class="bi bi-arrow-right fs-1"></i> <small>Continue</small>
                                </a>
                            </div> 
                            <input name="tabInfo" value="careerForm" hidden/>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade" id="Location">
               <div class="card shadow-sm border-0 rounded-4 mb-4 w-100">
                  <form asp-controller="Home" asp-action="UpdateUserProfile" method="post" data-action="UpdateUserProfileForm">
                      <div class="card-body">
                         <h5 class="fw-bold">Location</h5>
                         <a class="nav-link fw-bolder h5 edit-label-ending" data-action="EditLocation" style="cursor: pointer;">
                             <i class="bi bi-pencil-square"></i> Edit
                         </a>
                        <div class="d-flex mt-5 justify-content-between">
                            <div> 
                                <div>
                                    <i class="bi bi-geo-alt-fill text-primary"></i> 
                                    <strong>Originally From:</strong>
                                </div>
                                <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.FromLocation) ? "" : "ms-3")" data-group="labelLocationInfo" id="labelFromLocation">
                                    @Model.FromLocation
                                </span>
                            </div>                            
                        </div> 
                        <div class="floating-input mt-3 d-none" data-group="locationInfo">
                            <input type="text" class="form-control" name="FromLocation" value="@Model.FromLocation" placeholder=" "/>
                            <label for="fromLocation" class="text-muted">@(!string.IsNullOrEmpty(Model.FromLocation) ? "" : "Enter your origin location...")</label>
                        </div>                    
                        <p class="mt-2 mb-2">
                            <i class="bi bi-globe text-primary"></i> <strong>Website:</strong> <br />
                            <span class="text-muted fw-bold @(string.IsNullOrWhiteSpace(Model.Website) ? "" : "ms-3")" data-group="labelLocationInfo" id="labelWebsite">
                                @Model.Website
                            </span>
                        </p>
                        <div class="floating-input mt-3 d-none" data-group="locationInfo">
                            <input type="text" class="form-control" name="Website" value="@Model.Website" placeholder=" "/>
                            <label for="website" class="text-muted">@(!string.IsNullOrEmpty(Model.Website) ? "" : "Enter a website...")</label>
                        </div>                    
                        <button type="button" class="btn btn-secondary mt-3 mb-1 d-none" id="locationCancel" data-group="locationInfo">Cancel</button>
                        <button type="submit" class="btn btn-primary mt-3 mb-1 d-none" id="locationSave" data-group="locationInfo">Save Changes</button>
                        <input name="tabInfo" value="locationForm" hidden/>
                      </div>
                  </form>
               </div>
            </div>               
        </div>

    </div>

    @* *******************View Profile Picture Pop-up*********************************** *@
    <div class="modal fade" id="viewProfilePic" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Profile Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <img src="@Model.UserProfilePicUrl" class="post-image img-fluid " alt="Post image"
                         style="height : 450px; width : 500px">
                </div>
            </div>
        </div>
    </div>
    @* *******************View Cover Picture Pop-up*********************************** *@
    <div class="modal fade" id="viewCoverPic" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Profile Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <img src="@Model.UserCoverPicUrl" class="post-image img-fluid " alt="Post image"
                         style="height : 450px; width : 850px">
                </div>
            </div>
        </div>
    </div>


<script>
    document.addEventListener("DOMContentLoaded", function(){     
        let clearForm = "";
        let clickEditBio = 0; 
        let clickEditEducation = 0;
        let clickEditCareer = 0;
        let clickEditLocation = 0;
        const currentUserName = "@Model.UserName";

        const clickEventListenerMethod = 
        {
            async EditBio(e){
                if(clickEditBio === 1)
                {
                    clickEditBio = 0;
                    document.querySelectorAll('[data-group="labelAboutInfo"]').forEach(data =>{
                        data.classList.remove("d-none");
                    });
                    document.querySelectorAll('[data-group="aboutInfo"]').forEach(data =>{
                        data.classList.add("d-none");
                    });
                }else
                {
                    clickEditBio = 1;
                    document.querySelectorAll('[data-group="labelAboutInfo"]').forEach(data =>{
                        data.classList.add("d-none");
                    });
                    document.querySelectorAll('[data-group="aboutInfo"]').forEach(data =>{
                        data.classList.remove("d-none");
                    });
                    document.getElementById("saveBtn").addEventListener("click", function(e){
                        clearForm = "aboutForm";
                    });

                    document.getElementById("cancelBtn").addEventListener("click", function(){
                        document.querySelectorAll('[data-group="labelAboutInfo"]').forEach(data =>{
                            data.classList.remove("d-none");
                        });
                        document.querySelectorAll('[data-group="aboutInfo"]').forEach(data =>{
                            data.classList.add("d-none");
                        });                  
                    });
                }               
            },
           
            async EditEducation(e){
                if(clickEditEducation === 1)
                {
                    clickEditEducation = 0;
                    document.querySelectorAll('[data-group="labelEducationInfo"]').forEach(data =>{
                        data.classList.remove("d-none");
                    });
                    document.querySelectorAll('[data-group="educationInfo"]').forEach(data => {
                        data.classList.add("d-none");
                    });
                }else
                {
                    clickEditEducation = 1;
                    document.querySelectorAll('[data-group="labelEducationInfo"]').forEach(data =>{
                        data.classList.add("d-none");
                    });
                    document.querySelectorAll('[data-group="educationInfo"]').forEach(data => {
                        data.classList.remove("d-none");
                    });
                    document.getElementById("educationSave").addEventListener("click", function(e){
                        clearForm = "educationForm";
                    });

                    document.getElementById("educationCancel").addEventListener("click", function(){
                        document.querySelectorAll('[data-group="labelEducationInfo"]').forEach(data =>{
                            data.classList.remove("d-none");
                        });
                        document.querySelectorAll('[data-group="educationInfo"]').forEach(data => {
                            data.classList.add("d-none");
                        });
                    });
                }              
            },

            async EditCareer(e){
                if(clickEditCareer === 1)
                {
                    clickEditCareer = 0;
                    document.querySelectorAll('[data-group="labelCareerInfo"]').forEach(data =>{
                        data.classList.remove("d-none");
                    });
                    document.querySelectorAll('[data-group="careerInfo"]').forEach(data => {
                        data.classList.add("d-none");
                    });
                }else
                {
                    clickEditCareer = 1;
                    document.querySelectorAll('[data-group="labelCareerInfo"]').forEach(data =>{
                        data.classList.add("d-none");
                    });
                    document.querySelectorAll('[data-group="careerInfo"]').forEach(data => {
                        data.classList.remove("d-none");
                    });
                    document.getElementById("careerSave").addEventListener("click", function(e){
                        clearForm = "careerForm";
                    });

                    document.getElementById("careerCancel").addEventListener("click", function(){
                        document.querySelectorAll('[data-group="labelCareerInfo"]').forEach(data =>{
                            data.classList.remove("d-none");
                        });
                        document.querySelectorAll('[data-group="careerInfo"]').forEach(data => {
                            data.classList.add("d-none");
                        });
                    });
                }           
            },

            async EditLocation(e){
                if(clickEditLocation === 1)
                {
                    clickEditLocation = 0;
                    document.querySelectorAll('[data-group="labelLocationInfo"]').forEach(data =>{
                        data.classList.remove("d-none");
                    });
                    document.querySelectorAll('[data-group="locationInfo"]').forEach(data => {
                        data.classList.add("d-none");
                    });
                }else
                {
                    clickEditLocation = 1;
                    document.querySelectorAll('[data-group="labelLocationInfo"]').forEach(data =>{
                        data.classList.add("d-none");
                    });
                    document.querySelectorAll('[data-group="locationInfo"]').forEach(data => {
                        data.classList.remove("d-none");
                    });
                    document.getElementById("locationSave").addEventListener("click", function(e){
                        clearForm = "locationForm";
                    });

                    document.getElementById("locationCancel").addEventListener("click", function(){
                        document.querySelectorAll('[data-group="labelLocationInfo"]').forEach(data =>{
                            data.classList.remove("d-none");
                        });
                        document.querySelectorAll('[data-group="locationInfo"]').forEach(data => {
                            data.classList.add("d-none");
                        });
                    });
                }            
            },

            async RemoveCoverPic(e)
            {
                const response = await fetch(`RemoveCoverPicture`, {method: "PATCH", headers: {"Content-Type": "application/json"} });
                const res = await response.json();
                if (res.success)
                {
                    document.getElementById("bgImage").style.display = "none";
                    document.getElementById("removedCoverPic").innerHTML = `<div id="letterCoverImage" class="bg-secondary w-100" style="height: 400px; cursor : pointer; align-content : center;">
                                                                                <div class="text-capitalize text-white fw-bolder h1">
                                                                                    ${currentUserName.charAt(0).toUpperCase() + currentUserName.slice(1) ?? '?'}
                                                                                </div>
                                                                                <div> <small class="text-white h4">Add a Cover Picture</small> </div>
                                                                            </div>`;
                }else{
                    toastr.error("Technical issue, please try again later.");
                }              
            },

            async RemoveProfilePic(e)
            {
                const response = await fetch(`RemoveProfilePicture`, {method: "PATCH", headers: {"Content-Type": "application/json"} });
                const res = await response.json();
                if (res.success)
                {
                    document.getElementById("profileImg").style.display = "none";
                    document.getElementById("removedProfilePic").innerHTML = `<div id="letterProfileImage" class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center text-capitalize fw-bolder h2 profile-pic-phone-width'
                                                                                style='width:150px; height:150px; min-width:50px; min-height:50px;'>
                                                                                   ${currentUserName.charAt(0).toUpperCase()}
                                                                              </div>`;
                }else{
                    toastr.error("Technical issue, please try again later.");
                }
            }
       
        };


        const submitEventListenerMethod = 
        {
            async UpdateUserProfileForm(e){
                e.preventDefault();
                const form = e.target;
                const formData = new FormData(form);
                const bio = formData.get("Bio");
                const relationshipStatus = formData.get("RelationShipStatus");
                const location = formData.get("Location");
                const collegeName = formData.get("CollegeName");
                const course = formData.get("Course");
                const collegePeriod = formData.get("CollegePeriod");
                const highSchoolName = formData.get("HighSchoolName");
                const subject = formData.get("Subject");
                const schoolPeriod = formData.get("SchoolPeriod");
                const jobTitle = formData.get("JobTitle");
                const industry = formData.get("Industry");
                const jobPeriod = formData.get("JobPeriod");
                const fromLocatiom = formData.get("FromLocation");
                const website = formData.get("Website");
                try 
                {
                    const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    const res = await response.json();
                    if (res.success) 
                    {
                        if(clearForm)
                        {
                            if(clearForm === "aboutForm")
                            {
                                form.reset();
                                if(bio)
                                {
                                    const lblBio = document.getElementById("labelBio");
                                    lblBio.textContent = bio;
                                    lblBio.classList.add("ms-2")
                                }                                  
                                if(relationshipStatus)
                                {
                                    const lblRelationShip = document.getElementById("labelRelationStatus");
                                    lblRelationShip.textContent = relationshipStatus;
                                    lblRelationShip.classList.add("ms-2");
                                }                                  
                                if(location)
                                {
                                    const lblBio = document.getElementById("labelLocation");
                                    lblBio.textContent = location;
                                    lblBio.classList.add("ms-2");
                                }                                  

                                document.querySelectorAll('[data-group="labelAboutInfo"]').forEach(data =>{
                                    data.classList.remove("d-none");
                                });
                                document.querySelectorAll('[data-group="aboutInfo"]').forEach(info => {
                                    info.classList.add("d-none");
                                });
                            }else if(clearForm === "educationForm")
                            {
                                form.reset();
                                if(collegeName)
                                {
                                    const lblCollege = document.getElementById("labelCollegeName");
                                    lblCollege.textContent = collegeName;
                                    lblCollege.classList.add("ms-2");
                                }                                  
                                if(course)
                                {
                                    const lblCourse = document.getElementById("labelCourse");
                                    lblCourse.textContent = course;
                                    lblCourse.classList.add("ms-2");
                                }                                  
                                if(collegePeriod)
                                {
                                    const lblCollegePeriod = document.getElementById("labelCollegePeriod");
                                    lblCollegePeriod.textContent = collegePeriod;
                                    lblCollegePeriod.classList.add("ms-2");
                                }                                  
                                if(highSchoolName)
                                {
                                    const lblSchool = document.getElementById("labelHighSchoolName");
                                    lblSchool.textContent = highSchoolName;
                                    lblSchool.classList.add("ms-2");
                                }                                  
                                if(subject)
                                {
                                    const lblSubject = document.getElementById("labelSubject");
                                    lblSubject.textContent = subject;
                                    lblSubject.classList.add("ms-2");
                                }                                  
                                if(schoolPeriod)
                                {
                                    const lblSchoolPeriod = document.getElementById("labelSchoolPeriod");
                                    lblSchoolPeriod.textContent = schoolPeriod;
                                    lblSchoolPeriod.classList.add("ms-2");
                                }                                  

                                document.querySelectorAll('[data-group="labelEducationInfo"]').forEach(data =>{
                                    data.classList.remove("d-none");
                                });
                                document.querySelectorAll('[data-group="educationInfo"]').forEach(data => {
                                    data.classList.add("d-none");
                                });
                            }else if(clearForm === "careerForm")
                            {
                                form.reset();
                                if(jobTitle)
                                {
                                    const lblJobTitle = document.getElementById("labelJobTitle");
                                    lblJobTitle.textContent = jobTitle;
                                    lblJobTitle.classList.add("ms-2");
                                }                                  
                                if(industry)
                                {
                                    const lblIndustry = document.getElementById("labelIndustry");
                                    lblIndustry.textContent = industry;
                                    lblIndustry.classList.add("ms-2");
                                }                                  
                                if(jobPeriod)
                                {
                                    const lblJobPeriod = document.getElementById("labelJobPeriod");
                                    lblJobPeriod.textContent = jobPeriod;
                                    lblJobPeriod.classList.add("ms-2");
                                }                                  

                                document.querySelectorAll('[data-group="labelCareerInfo"]').forEach(data =>{
                                    data.classList.remove("d-none");
                                });
                                document.querySelectorAll('[data-group="careerInfo"]').forEach(data => {
                                    data.classList.add("d-none");
                                });
                            }else
                            {
                                form.reset();
                                if(fromLocatiom)
                                {
                                    const lblFromLoc = document.getElementById("labelFromLocation");
                                    lblFromLoc.textContent = fromLocatiom;
                                    lblFromLoc.classList.add("ms-2");
                                }                                   
                                if(website)
                                {
                                    const lblWeb = document.getElementById("labelWebsite");
                                    lblWeb.textContent = website;
                                    lblWeb.classList.add("ms-2");
                                }
                                   
                                document.querySelectorAll('[data-group="labelLocationInfo"]').forEach(data =>{
                                    data.classList.remove("d-none");
                                });
                                document.querySelectorAll('[data-group="locationInfo"]').forEach(data => {
                                    data.classList.add("d-none");
                                });
                            }
                        }        
                        toastr.success("Successfully Updated.");
                    }else{
                        toastr.error("Failed to update user info, Please try again later.");
                    }
                }catch(Error){
                    toastr.error(`Failed to update user info due to : ${Error}`);
                }
            }
            

        };


        const onChangeEventListenerMethod = 
        {
            async UpdateCoverPic(e)
            {
                const file = e.target.files[0];
                if (file) 
                {
                    const formImg = new FormData();
                    formImg.append("coverImage", file);
                    const res = await fetch('/Home/UpdateCoverPicture', {method : "PATCH", body : formImg});
                    const result = await res.json();
                    if(result.success)
                    {
                        const isImage = document.getElementById("bgImage");
                        if(isImage)
                        {
                            isImage.src = URL.createObjectURL(file);
                        }else
                        {
                            document.getElementById("letterCoverPic").classList.add("d-none");
                            document.getElementById("updatedCoverPic").innerHTML = `<img src="${URL.createObjectURL(file)}" id="bgImage" class="img-fluid w-100" style="height: 450px; object-fit: cover; cursor : pointer;" alt="Cover Image">`;                         
                        }   
                    }else
                    {
                        toastr.error("Failed to change cover picture");
                    }        
                }
            },

            async UpdateProfilePic(e)
            {
                const file = e.target.files[0];
                const formImg = new FormData();
                formImg.append("profileImage", file);
                const res = await fetch('/Home/UpdateProfilePicture', {method : "PATCH", body : formImg});
                const result = await res.json();
                if(result.success)
                { 
                    const isImage = document.getElementById("profileImg");
                    if(isImage)
                    {
                         isImage.src = URL.createObjectURL(file);
                    }else
                    {
                        document.getElementById("letterProfilePic").classList.add("d-none");
                        document.getElementById("updatedProfilePic").innerHTML = 
                        `<img src="${URL.createObjectURL(file)}" id="profileImg" class="rounded-circle border border-4 border-white profile-pic-phone-width"
                                    style="width: 150px; height: 150px; min-width : 110px; min-height : 110px; object-fit: cover; cursor : pointer" />`;
                    }
                }else
                {
                    toastr.error(`Failed to change profile picture due to : ${result.message}`);
                }
            }

          
        };



        document.addEventListener("click", async function(e){
            const action = e.target.dataset.action;
            if(!action) return;
            const handler = await clickEventListenerMethod[action];
            if(handler) handler(e);
        });

        document.addEventListener("submit", async function(e){
            const submit = e.target.dataset.action;
            if(!submit) return;
            const handler = await submitEventListenerMethod[submit];
            if(handler) handler(e);
        });

        document.addEventListener("change" , async function(e){
            const onChange = e.target.dataset.action;
            if(!onChange) return;
            const handler = onChangeEventListenerMethod[onChange];
            if(handler) handler(e);
        });



        const toggle = document.getElementById("toggleCoverPicOptions");
        const menu = document.getElementById("coverPicDropDownMenu");
        const isImage = document.getElementById("bgImage");
        if(isImage)
        {
            toggle.addEventListener("click", function(e){
                e.stopPropagation();
                if(menu)
                {
                    const menuDisplayState = window.getComputedStyle(menu).display === "none";
                    menu.style.display = menuDisplayState ? "block" : "none";
                    menu.querySelector("a").focus();
                }         
            });
        }else
        {
            const triggerImageInput = document.getElementById("coverPicInput");
            toggle.addEventListener("click", function(e){
                triggerImageInput.click();
            });
        }       
        document.addEventListener("click", function(){
            menu.style.display = "none";
        });


        const btnToggle = document.getElementById("btnToggleCoverPicOptions");
        const btnMenu = document.getElementById("coverPicDropDownMenu");
        if(isImage)
        {
            btnToggle.addEventListener("click", function(e){
                e.stopPropagation();
                if(btnMenu)
                {
                    const isHidden = window.getComputedStyle(btnMenu).display === "none";
                    btnMenu.style.display = isHidden ? "block" : "none";
                    btnMenu.querySelector("a").focus();
                }
            });
        }else
        {
            const triggerImageInput = document.getElementById("coverPicInput");
            btnToggle.addEventListener("click", function(e){
                triggerImageInput.click();
            });
        }    
        document.addEventListener("click", function(){
            btnMenu.style.display = "none";
        });

        const profileToggle = document.getElementById("toggleProfileDropDown");
        const profileMenu = document.getElementById("profileDropDownMenu");
        const isProfileImg = document.getElementById("profileImg");
        if(isProfileImg){
            profileToggle.addEventListener("click", function(e){
                e.stopPropagation();
                if(profileMenu)
                {
                    const isHidden = window.getComputedStyle(profileMenu).display === "none";
                    profileMenu.style.display = isHidden ? "block" : "none";
                    if(isHidden) profileMenu.querySelector("a").focus();              
                }
            });
        }else{
            const triggerProfile_ImgInput = document.getElementById("profilePicInput");
            profileToggle.addEventListener("click", function(e){
                triggerProfile_ImgInput.click();
            });
        }      
        document.addEventListener("click", function(){
            profileMenu.style.display = "none";
        });






    });    

    document.getElementById('EducationTab').addEventListener('click', function (e) {
        e.preventDefault();
        const tabTrigger = document.querySelector('button[data-bs-target="#Education"]');
        const tab = new bootstrap.Tab(tabTrigger);
        tab.show();
        // tabTrigger.addEventListener('shown.bs.tab', function () {
        //     const educationTab = document.getElementById("editEducationBtn");
        //     educationTab.click();
        // });
    });

    document.getElementById('CareerTab').addEventListener('click', function (e) {
        e.preventDefault();
        const tabTrigger = document.querySelector('button[data-bs-target="#Career"]');
        const tab = new bootstrap.Tab(tabTrigger);
        tab.show();
    });

    document.getElementById('LocationTab').addEventListener('click', function (e) {
        e.preventDefault();        
        const tabTrigger = document.querySelector('button[data-bs-target="#Location"]');
        const tab = new bootstrap.Tab(tabTrigger);
        tab.show();       
    });   

</script>



