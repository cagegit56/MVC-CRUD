        function handlePageSizeChange() 
        {
            pageSize = parseInt(this.value);
            currentPage = 1;
            switch(selectedTab)
            {
                case 'friend':
                loadFriends(pageSize, currentPage);
                break;
                case 'request' :
                loadFriendRequest(pageSize, currentPage);
                break;
                case 'sentRequest' :
                loadSentRequest(pageSize, currentPage);
                break;
                default :
                loadFriends(pageSize, currentPage);
            }
        }

        const container = document.getElementById('pagination');
        const DOTS = 'DOTS';   

        function renderPagination(container, { currentPage, totalPages, onPageChange, siblingCount = 1 }) 
        {
            container.innerHTML = '';
            if (!totalPages || totalPages <= 1) return;

            currentPage = Math.min(Math.max(currentPage, 1), totalPages);

            const createItem = (page, label, disabled, active) => {
                const li = document.createElement('li');
                li.className = `page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}`;
                li.innerHTML = `<a class="page-link clickable" >${label}</a>`;

                if (!disabled) {
                    li.addEventListener('click', () => onPageChange(page));
                }
                return li;
            };

            function createEllipsis() 
            {
                const li = document.createElement('li');
                li.className = "page-item disabled";
                li.innerHTML = `<span class="page-link">...</span>`;
                return li;
            }

            const isFirstPage = currentPage === 1;
            container.appendChild( createItem( isFirstPage ? 1 : currentPage - 1,'«', isFirstPage ) );

            const range = getPaginationRange(currentPage, totalPages, siblingCount);
            for (const item of range) 
            {
                if (item === DOTS) {
                    container.appendChild(createEllipsis());
                } else {
                    container.appendChild( createItem(item, item, false, item === currentPage ));
                }
            }

            const isLastPage = currentPage === totalPages;
            container.appendChild( createItem(isLastPage ? totalPages : currentPage + 1, '»', isLastPage) );
        }

        
        function getPaginationRange(currentPage, totalPages, siblingCount = 1) 
        {
            if (totalPages <= 0) return [];

            const range = (start, end) =>
            Array.from({ length: end - start + 1 }, (_, i) => start + i);

            const totalVisibleSlots = siblingCount * 2 + 5;

            if (totalVisibleSlots >= totalPages) 
            {
                return range(1, totalPages);
            }

            const leftSiblingIndex = Math.max(currentPage - siblingCount, 1);
            const rightSiblingIndex = Math.min(currentPage + siblingCount, totalPages);

            const shouldShowLeftDots = leftSiblingIndex > 2;
            const shouldShowRightDots = rightSiblingIndex < totalPages - 1;

            if (!shouldShowLeftDots && shouldShowRightDots) 
            {
                const leftItemCount = 3 + siblingCount * 2;
                return [...range(1, leftItemCount), DOTS, totalPages];
            }

            if (shouldShowLeftDots && !shouldShowRightDots) 
            {
                const rightItemCount = 3 + siblingCount * 2;
                return [1, DOTS, ...range(totalPages - rightItemCount + 1, totalPages)];
            }

            return [1, DOTS, ...range(leftSiblingIndex, rightSiblingIndex), DOTS, totalPages];
        }              
               

        function update() 
        {
            state.totalPages >= 1 ? document.getElementById('paginationInfo').innerHTML = ` Showing Page ${state.currentPage} of ${state.totalPages}`
                    : document.getElementById('paginationInfo').innerHTML = "";
            renderPagination(container, { currentPage: state.currentPage, totalPages: state.totalPages, 
                onPageChange: (page) => {
                    state.currentPage = page;
                    switch(selectedTab)
                    {
                        case 'friend':
                        loadFriends(pageSize, page);
                        break;
                        case 'request' :
                        loadFriendRequest(pageSize, page);
                        break;
                        case 'sentRequest' :
                        loadSentRequest(pageSize, page);
                        break;
                        default :
                        loadFriends(pageSize, page);
                    }
                    update();
                },
            });
        }

