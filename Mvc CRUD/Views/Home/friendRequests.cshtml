@using System.Text.Json
@using Mvc_CRUD.Pagination
@model PaginateResponse<List<Mvc_CRUD.Dto.FriendUserProfileDto>>

@{
    ViewData["Title"] = "Find Friends";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<link href="~/css/site.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<div class="container py-5">
    <h3 class="text-center text-primary">
        <i class="fa-solid fa-users me-2"></i>Find Friends
    </h3>
    <div class="container mt-5">
        <ul class="nav nav-tabs justify-content-center" id="myTab" role="tablist" style="font-weight:500">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="friend-tab" data-bs-toggle="tab" style="color: #0d6efd"
                        data-bs-target="#friend" type="button" role="tab" aria-controls="friend"
                        aria-selected="true">
                    Add Friends
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="request-tab" data-bs-toggle="tab" style="color: #0d6efd"
                        data-bs-target="#request" type="button" role="tab" aria-controls="request"
                        aria-selected="false">
                    View Friend Request
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="sentRequest-tab" data-bs-toggle="tab" style="color: #0d6efd"
                        data-bs-target="#sentReq" type="button" role="tab" aria-controls="sentReq"
                        aria-selected="false">
                    Sent Friend Request
                </button>
            </li>
        </ul>

        <div class="tab-content mt-4" id="myTabContent">
            <div class="tab-pane fade show active" id="friend" role="tabpanel" aria-labelledby="friend-tab">
                <div class="card friend-card w-100 p-3">
                    @if(Model.Data != null && Model.Data.Any())
                    {                            
                        foreach(var potentialFriend in Model.Data)
                        {
                            <div class="card h-card w-100 shadow-sm border-0 p-3 mb-2" id="row-@potentialFriend.Id">
                                <div class="d-flex align-items-center justify-content-between flex-wrap">
                                    <div class="d-flex">
                                        @if (!string.IsNullOrEmpty(potentialFriend.UserProfilePicUrl))
                                        {
                                            <img src="@potentialFriend.UserProfilePicUrl" id="viewProfile" class="rounded-circle me-1 clickable friend-request-pic"
                                               data-id="@potentialFriend.UserId" style="width: 50px; height: 50px; object-fit: cover; cursor : pointer" />                                             
                                        }
                                        else
                                        {
                                            <div id="viewProfile" class="rounded-circle bg-primary clickable text-white d-flex fw-semibold align-items-center justify-content-center me-1"
                                                data-id="@potentialFriend.UserId" style="width:50px; height:50px; font-size:1.5rem;"> @potentialFriend.UserName.Substring(0,1).ToUpper()                                        
                                            </div>
                                        }                                   
                                        <div class="col">
                                            <div class="fw-bold"> @(char.ToUpper(@potentialFriend.UserName[0]) + @potentialFriend.UserName.Substring(1)) @(char.ToUpper(@potentialFriend.LastName[0]) + @potentialFriend.LastName.Substring(1))</div>
                                            <div class="mb-0"> <small class="text-muted">1.3k followers</small> </div>
                                            <div> <small class="text-muted">3 Mutual Friends</small> </div>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex gap-2">
                                        <button type="submit" id="sendBtn-@potentialFriend.Id" class="btn btn-primary px-3" 
                                            data-action="SendFriendRequest" 
                                            data-userinfo='{"userid": "@potentialFriend.UserId", "username": "@potentialFriend.UserName", "lastname": "@potentialFriend.LastName", "profilepic": "@potentialFriend.UserProfilePicUrl", "id": @potentialFriend.Id, "email": "@potentialFriend.Email" }' )">
                                            <i class="fa-solid fa-user-plus me-1"></i>Add Friend
                                        </button>      
                                        <button id="removeBtn-@potentialFriend.Id" type="submit" class="btn btn-outline-danger px-3" 
                                            data-action="RemoveUser"
                                            data-id="@potentialFriend.Id"
                                            data-userid="@potentialFriend.UserId"
                                            data-username="@potentialFriend.UserName">
                                            <i class="fa-solid fa-user-minus me-1"></i>Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }                            
                    }else if (Model.Error != null)
                    {
                        <div class="container mb-1 mt-1">
                            <div class="text-center">
                                <div class="display-1 text-muted mb-1">
                                    <i class="bi bi-exclamation-triangle text-danger"></i>
                                </div>
                                <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                                <p class="text-muted mb-4">Please refresh or try again later...</p>
                                <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                    <i class="bi bi-plus-circle me-2"></i>Refresh
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center w-100">No new potential friends found.</div>
                    }
                </div> 
            </div>
            <div class="tab-pane fade" id="request" role="tabpanel" aria-labelledby="request-tab"></div>
            <div class="tab-pane fade" id="sentReq" role="tabpanel" aria-labelledby="sentRequest-tab"></div>
        </div>
    </div>

    <div id="loadingSpinner" class="d-flex justify-content-center my-4 mb-3" style="display:none;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <label for="pageSize" class="mb-0">Rows per page:</label>
            <select id="pageSize" class="form-select form-select-sm w-auto">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="49">50</option>
            </select>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <div id="paginationInfo" class="text-muted small"></div>
            <ul class="pagination mb-0 flex-wrap" id="pagination"></ul>
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module">
        import {friendRequestApi} from '/js/API/ApiCalls.js';
        
        let currentPage = 1;
        let pageSize = 5;
        let selectedTab = "";
        let minimizedMsgCard = false;
        let state = { currentPage: 1, totalPages : @Model.TotalPages };
        const currentUserName = "@Model.UserName";
        
        toastr.options = {
            "closeButton": true,
            "progressBar": false,
            "positionClass": "toast-top-center",
            "timeOut": "3000"
        };

        document.addEventListener('DOMContentLoaded', () => 
        {
            const profile = document.querySelectorAll('#viewProfile');
            profile.forEach( element => {
                element.addEventListener("click", (e) => {
                    const userId = e.target.dataset.id;
                    const redirectUrl = '@Url.Action("ExternalUserProfile", "Home")';
                    window.location.href = `${redirectUrl}/?userId=${userId}`;
                });
            });

            document.getElementById('pageSize').addEventListener('change', handlePageSizeChange);
            
            const tabElements = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabElements.forEach(tab => {
                tab.addEventListener('shown.bs.tab', function (event) {
                    const activeTabId = event.target.id;

                    if (activeTabId === "friend-tab") 
                    {
                        selectedTab = "friend";
                        currentPage = 1;
                        pageSize = 5;
                        state.currentPage = 1;
                        document.getElementById("pageSize").value = 5;
                        loadFriends(pageSize, currentPage);
                    }else if (activeTabId === "request-tab") 
                    {
                        selectedTab = "request";
                        currentPage = 1;
                        pageSize = 5;
                        state.currentPage = 1;
                        document.getElementById("pageSize").value = 5;
                        loadFriendRequest(pageSize, currentPage);
                    }else {
                        selectedTab = "sentRequest";
                        currentPage = 1;
                        pageSize = 5;
                        state.currentPage = 1;
                        document.getElementById("pageSize").value = 5;
                        loadSentRequest(pageSize, currentPage);
                    }
                });
            });

            switch(selectedTab)
            {
                case 'friend':
                loadFriends(pageSize, currentPage);
                break;
                case 'request' :
                loadFriendRequest(pageSize, currentPage);
                break;
                case 'sentRequest' :
                loadSentRequest(pageSize, currentPage);
                break;
                default:
                defaultLoad();
            }  

        });

        /************************************************All potential Friends/Requesting *****************************/

        async function defaultLoad()
        {
            const model = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, 
                new JsonSerializerOptions
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                })
            )
            document.getElementById("loadingSpinner").classList.add("d-none");
            update();
        }
        
        async function loadFriends(size,pageNumber) 
        {
            const loadSpinner = document.getElementById("loadingSpinner");
            loadSpinner.classList.remove("d-none");
            try 
            {
                const result = await friendRequestApi.getAllPotentialFriends(size,pageNumber);
                if (result.error) 
                {
                    loadSpinner.classList.add("d-none");
                    state.totalPages = 0;
                    update();
                    return document.getElementById('friend').innerHTML = `
                        <div class="container mb-1 mt-1">
                            <div class="text-center">
                                <div class="display-1 text-muted mb-1">
                                    <i class="bi bi-exclamation-triangle text-danger"></i>
                                </div>
                                <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                                <p class="text-muted mb-4">Please refresh or try again later...</p>
                                <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                    <i class="bi bi-plus-circle me-2"></i>Refresh
                                </button>
                            </div>
                    </div> `;
                }
                renderFriends(result.data);
                state.totalPages = result.totalPages;
                update();
            }catch (error) {
                state.totalPages = 0;
                update();
                document.getElementById('friend').innerHTML = `
                        <div class="container mb-1 mt-1">
                            <div class="text-center">
                                <div class="display-1 text-muted mb-1">
                                    <i class="bi bi-exclamation-triangle text-danger"></i>
                                </div>
                                <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                                <p class="text-muted mb-4">Please refresh or try again later...</p>
                                <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                    <i class="bi bi-plus-circle me-2"></i>Refresh
                                </button>
                            </div>
                    </div>`;
            }
            loadSpinner.classList.add("d-none");
        }

        function renderFriends(friends) 
        {
            const container = document.getElementById('friend');
            container.innerHTML = "";
            container.classList.remove("d-none");
            container.innerHTML = '';
            if (!friends || friends.length === 0) return container.innerHTML = `<div class="alert alert-info text-center w-100">No friends found.</div>`;

            const card = document.createElement('div');
            card.className = 'card friend-card w-100 p-3';
            const div = document.createElement('div');
            div.className = 'd-flex flex-column align-items-center gap-2';
            friends.forEach(friend => {               
                div.innerHTML += `
                    <div class="card h-card w-100 shadow-sm border-0 p-3" id="row-${friend.id}">
                        <div class="d-flex align-items-center justify-content-between flex-wrap">
                            <div class="d-flex">
                                ${friend.userProfilePicUrl ? `<img src="${friend.userProfilePicUrl}" id="viewProfile" data-id="${friend.userId}" class="rounded-circle me-1 clickable friend-request-pic"
                                                                    style="width: 50px; height: 50px; object-fit: cover; cursor : pointer" />` 
                                                : ` <div id="viewProfile" data-id="${friend.userId}" class="rounded-circle bg-primary text-white d-flex clickable fw-semibold align-items-center justify-content-center me-1"
                                                        style="width:50px; height:50px; font-size:1.5rem;">
                                                        ${(friend.userName).charAt(0).toUpperCase()}
                                                </div>`
                                }                           
                                <div class="col">
                                    <div class="fw-bold">${friend.userName.charAt(0).toUpperCase() + friend.userName.slice(1) +" " + friend.lastName.charAt(0).toUpperCase() + friend.lastName.slice(1) ?? '?'}</div>
                                    <div class="mb-0"> <small class="text-muted">1.3k followers</small> </div>
                                    <div> <small class="text-muted">3 Mutual Friends</small> </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                    <button type="submit" id="sendBtn-${friend.id}" class="btn btn-primary px-3" 
                                        data-action="SendFriendRequest"
                                        data-userinfo='{"userid": "${friend.userId}", "username": "${friend.userName}", "lastname": "${friend.lastName}", "profilepic": "${friend.userProfilePicUrl}", "id": ${friend.id}, "email": "${friend.email}" }'>
                                        <i class="fa-solid fa-user-plus me-1"></i>Add Friend
                                    </button>
                         
                                    <button id="removeBtn-${friend.id}" type="submit" class="btn btn-outline-danger px-3"
                                        data-action="RemoveUser"
                                        data-id="${friend.id}"
                                        data-userid="${friend.userId}"
                                        data-username="${friend.userName}">
                                        <i class="fa-solid fa-user-minus me-1"></i>Remove
                                    </button>
                            </div>
                        </div>
                    </div>`;
                card.appendChild(div);
                container.appendChild(card);
            });

            const viewProfile = document.querySelectorAll('#viewProfile');
            viewProfile.forEach( element => {
                element.addEventListener("click", (e) => {
                    const userId = e.target.dataset.id;
                    const redirectUrl = '@Url.Action("ExternalUserProfile", "Home")';
                    window.location.href = `${redirectUrl}/?userId=${userId}`;
                });
            });

        }
        

        /**************************************************Recieved Requests *******************************************/
        async function loadFriendRequest(size,pageNumber) 
        {
            const loadSpinner = document.getElementById("loadingSpinner");
            loadSpinner.classList.remove("d-none");
            try 
            {
                const result = await friendRequestApi.getRecievedRequest(size,pageNumber);
                if (result.error) 
                {
                    loadSpinner.classList.add("d-none");
                    state.totalPages = 0;
                    update();
                    return document.getElementById('request').innerHTML = `
                        <div class="container mb-1 mt-1">
                            <div class="text-center">
                                <div class="display-1 text-muted mb-1">
                                    <i class="bi bi-exclamation-triangle text-danger"></i>
                                </div>
                                <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                                <p class="text-muted mb-4">Please refresh or try again later... </p>
                                <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                    <i class="bi bi-plus-circle me-2"></i>Refresh
                                </button>
                            </div>
                    </div> `;
                }
                renderReceivedFriendRequests(result.data);
                state.totalPages = result.totalPages;
                update();
            }catch (error) {
                state.totalPages = 0;
                update();
                document.getElementById('request').innerHTML = `
                        <div class="container mb-1 mt-1">
                        <div class="text-center">
                            <div class="display-1 text-muted mb-1">
                                <i class="bi bi-exclamation-triangle text-danger"></i>
                            </div>
                            <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                            <p class="text-muted mb-4">Please refresh or try again later... </p>
                            <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                <i class="bi bi-plus-circle me-2"></i>Refresh
                            </button>
                        </div>
                </div>`;
            }
            loadSpinner.classList.add("d-none");
        }

        function renderReceivedFriendRequests(friends) 
        {
            const container = document.getElementById('request');
            container.innerHTML = '';
            if (!friends || friends.length === 0) return container.innerHTML = `<div class="alert alert-info text-center w-100">You have no pending friend request.</div>`;

            const card = document.createElement('div');
            card.className = 'card friend-card w-100 p-3';
            const div = document.createElement('div');
            div.className = 'd-flex flex-column align-items-center gap-3';
            friends.forEach(friend => {
                div.innerHTML += `                   
                           <div id="row-${friend.id}" class="card h-card w-100 shadow-sm border-0 p-3">
                                <div class="d-flex align-items-center justify-content-between flex-wrap">
                                    <div class="d-flex">
                                        ${friend.profilePicUrl ? `<img src="${friend.profilePicUrl}" id="viewProfile" data-id="${friend.userId}" class="rounded-circle clickable me-1 friend-request-pic"
                                                                        style="width: 50px; height: 50px; object-fit: cover; cursor : pointer" />` 
                                                    : ` <div id="viewProfile" data-id="${friend.userId}" class="rounded-circle bg-primary text-white d-flex clickable fw-semibold align-items-center justify-content-center me-1"
                                                            style="width:50px; height:50px; font-size:1.5rem;">
                                                            ${(friend.userName).charAt(0).toUpperCase()}
                                                    </div>`
                                        }
                                        <div>
                                            <h6 class="fw-bold mb-1">${friend.userName.charAt(0).toUpperCase() + friend.userName.slice(1) + " " + friend.lastName.charAt(0).toUpperCase() + friend.lastName.slice(1) ?? '?'}</h6>
                                            <small class="text-muted">1.3k followers</small><br />
                                            <small class="text-muted">3 Mutual Friends</small>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button id="requestBtn-${friend.id}" type="submit" class="btn btn-primary px-3" 
                                            data-action="AcceptFriendRequest"
                                            data-id="${friend.id}"
                                            data-userid="${friend.userId}"
                                            data-username="${friend.userName}">
                                            <i class="fa-solid fa-user-plus me-1"></i>Accept Request
                                        </button>
                                        <button id ="rejectRequestBtn-${friend.id}" type="submit" class="btn btn-outline-danger px-3" 
                                            data-action="RejectRecievedRequest"
                                            data-id="${friend.id}"
                                            data-userid="${friend.userId}">
                                            <i class="fa-solid fa-user-minus me-1"></i>Reject Request
                                        </button>
                                    </div>
                                </div>
                           <div/>
                       </div>`;
                card.appendChild(div);
                container.appendChild(card);
            });

            const profileView = document.querySelectorAll('#viewProfile');
            profileView.forEach( element => {
                element.addEventListener("click", (e) => {
                    const userId = e.target.dataset.id;
                    const redirectUrl = '@Url.Action("ExternalUserProfile", "Home")';
                    window.location.href = `${redirectUrl}/?userId=${userId}`;
                });
            });
            
        }       


        /* ************************************************Sent Requests ***********************************************/
        async function loadSentRequest(size,pageNumber) 
        {
            const loadSpinner = document.getElementById("loadingSpinner");
            loadSpinner.classList.remove("d-none");
            try 
            {
                const result = await friendRequestApi.getSentFriendRequest(size,pageNumber);
                if (result.error) 
                {
                    loadSpinner.classList.add("d-none");
                    state.totalPages = 0;
                    update();
                    return document.getElementById('sentReq').innerHTML = `
                        <div class="container mb-1 mt-1">
                            <div class="text-center">
                                <div class="display-1 text-muted mb-1">
                                    <i class="bi bi-exclamation-triangle text-danger"></i>
                                </div>
                                <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                                <p class="text-muted mb-4">Please refresh or try again later... </p>
                                <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                    <i class="bi bi-plus-circle me-2"></i>Refresh
                                </button>
                            </div>
                    </div> `;
                }
                renderSentRequests(result.data);
                state.totalPages = result.totalPages;
                update();
            }catch (error) {
                state.totalPages = 0;
                update();
                document.getElementById('sentReq').innerHTML = `
                    <div class="container mb-1 mt-1">
                        <div class="text-center">
                            <div class="display-1 text-muted mb-1">
                                <i class="bi bi-exclamation-triangle text-danger"></i>
                            </div>
                            <h6 class="mb-1">Technical Isssue!<br />We currently attending to the issue...</h6>
                            <p class="text-muted mb-4">Please refresh or try again later... </p>
                            <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                <i class="bi bi-plus-circle me-2"></i>Refresh
                            </button>
                        </div>
                </div>`;
            }
            loadSpinner.classList.add("d-none");
        }

        function renderSentRequests(friends) 
        {
            const container = document.getElementById('sentReq');
            container.innerHTML = '';
            if (!friends || friends.length === 0) return container.innerHTML = `<div class="alert alert-info text-center w-100">You have no pending sent friend request.</div>`;
              
            const card = document.createElement('div');
            card.className = 'card friend-card w-100 p-3';
            const div = document.createElement('div');
            div.className = 'd-flex flex-column align-items-center gap-3';
            friends.forEach(friend => {  
                div.innerHTML += `
                    <div class="card w-100 h-card shadow-sm border-0 p-3" id="row-${friend.id}">
                        <div class="d-flex align-items-center justify-content-between flex-wrap">
                            <div class="d-flex">
                                ${friend.toUser_ProfilePicUrl ? `<img src="${friend.toUser_ProfilePicUrl}" id="viewProfile" data-id="${friend.toUserId}" class="rounded-circle me-1 clickable friend-request-pic"                                                        style="width: 50px; height: 50px; object-fit: cover; cursor : pointer" />` 
                                            : `<div id="viewProfile" data-id="${friend.toUserId}" class="rounded-circle bg-primary text-white d-flex clickable fw-semibold align-items-center justify-content-center me-1"
                                                    style="width:50px; height:50px; font-size:1.5rem;"> ${(friend.toUserName).charAt(0).toUpperCase()}
                                                </div>`
                                }
                                <div>
                                    <h6 class="fw-bold mb-1">${friend.toUserName.charAt(0).toUpperCase() + friend.toUserName.slice(1)+ " " + friend.toUser_LastName.charAt(0).toUpperCase() + friend.toUser_LastName.slice(1) ?? '?'}</h6>
                                    <small class="text-muted">1.3k followers</small><br />
                                    <small class="text-muted">3 Mutual Friends</small>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button id="cancelRequestBtn-${friend.id}" type="submit" class="btn btn-primary px-3" 
                                    data-action="CancelSentRequest"
                                    data-id="${friend.id}"
                                    data-userid="${friend.toUserId}">
                                    <i class="fa-solid fa-user-plus me-1"></i>Cancel Request
                                </button>
                                <button type="button" data-action="SendMessage" data-userid="${friend.toUserId}" data-id="${friend.id}" class="btn btn-light text-primary text-bold px-4 rounded-pill p-2"> 
                                     <i class="bi bi-send"></i> Message
                                </button>

                                <div class="send-msg-menu position-fixed bottom-0 end-0 d-none" id="sendMessageMenu-${friend.id}">
                                    <div class="input group">
                                        <div class="card shadow-sm border-0 gap-0">
                                            <div class="position-relative">
                                                <div class="position-absolute end-0">
                                                    <i class="bi bi-dash-lg clickable" id="minimizeMsgPopUp" data-action="MinimizeMessages" data-id="${friend.id}"></i>
                                                    <i class="bi bi-x-lg m-1 clickable" id="closeMsgPopUp" data-action="CloseMessages" data-id="${friend.id}"></i>
                                                </div>
                                            </div>
                                            <div class="card-body clickable" data-action="ExitMinimizedMsg" data-id="${friend.id}">
