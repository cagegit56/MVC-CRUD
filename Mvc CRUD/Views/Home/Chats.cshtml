@using System.Security.Claims
@using Mvc_CRUD.Dto
@using Mvc_CRUD.Pagination
@using Newtonsoft.Json
@model PaginateResponse<List<ChatsDto>>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<link rel="stylesheet" href="~/css/site.css" />

<div class="chat-app container-fluid h-100 d-flex p-0">
    <div class="row flex-fill w-100 shadow-sm">
        <div id="contactsPane" class="col-12 col-md-4 col-lg-3 border-end p-0">
            <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="mb-0">Chats</h5>
                <a class="btn btn-sm btn-outline-primary" href="#">New</a>
            </div>
            <div id="contacts" class="overflow-auto p-2" style="height: 28rem">
                <div class="list-group list-group-flush" id="contactUsers">
                    @if (!string.IsNullOrEmpty(Model.Error))
                    {
                        <div class="text-center py-3">
                            <div class="display-1 text-muted mb-1">
                                <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                            </div>
                            <h6 class="mb-1">Technical Issue!<br />We currently attending to the issue.</h6>
                            <p class="text-muted mb-4">Please refresh or try again later. </p>
                            <button class="btn btn-primary btn-sm btn-lg action-btn" onclick="window.location.href='/Home/Chats';">
                                <i class="bi bi-plus-circle me-2"></i>Refresh
                            </button>
                        </div>
                    }else if (Model.Data.Any())
                    {
                        @foreach (var contact in Model.Data)
                        {                            
                            <div class="d-flex gap-1 border-bottom py-3 chat-contact clickable" id="contactId-@contact.UserId" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                @if (!string.IsNullOrEmpty(contact.ProfilePicUrl))
                                {
                                    <img src="@contact.ProfilePicUrl" class="rounded-circle" style="width:45px; height:45px; object-fit: cover;" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl" />
                                }
                                else
                                {
                                    <div class="avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                            style="width:44px; height:44px; min-width:44px; min-height:44px;" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                        @(contact.UserName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div class="flex-grow-1 overflow-hidden">
                                    <h6 class="mb-1 text-truncate" style="max-width: 70%;" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                        @(char.ToUpper(contact.UserName[0]) + contact.UserName.Substring(1)) @(char.ToUpper(contact.LastName[0]) + contact.LastName.Substring(1))
                                    </h6>
                                    <div class="d-flex justify-content-between" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                        <p class="mb-0 text-truncate text-muted small" id="message-@contact.UserId" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                            @if (contact.Sender == "CurrentUser" && contact.Message != $"You are now Friends with {char.ToUpper(contact.UserName[0]) + contact.UserName.Substring(1)} Send a Message to Start a Chat.")
                                            {
                                                var msg = $"You : {contact.Message}";
                                                @msg
                                            }
                                            else
                                            {
                                                @contact.Message
                                            }
                                        </p>
                                        <small class="text-muted flex-shrink-0 chatTime" data-time="@contact.SentOn" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl" style="white-space: nowrap; margin-left: 8px;"></small>
                                    </div>
                                </div>
                            </div>
                        }
                    }else {
                        <div class="alert alert-info text-center w-100">
                             No contacts yet.<br /> <a class="remove-link-underline" href="friendRequests">Add contacts</a>
                        </div>
                    }                                            
                </div>
            </div>
        </div>

        <div id="chatPane" class="col p-0 bg-light d-flex flex-column" style="height: 32rem; position: relative;">
            <div id="chatHeader" class="p-3 border-bottom d-flex bg-white align-items-center">                
                @if (!string.IsNullOrEmpty(Model.ProfilePicUrl))
                {
                    <img src="@Model.ProfilePicUrl" class="rounded-circle me-2 border border-2 border-success clickable" data-action="Test" style="width:55px; height: 55px; object-fit: cover;" />
                }else {
                    <div class="me-2 avatar-lg rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                        @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "?")
                    </div>
                }              
                <div class="flex-grow-1">
                    <strong id="chatUserName">Select a contact</strong>
                    <div class="small text-muted" id="chatStatus">To Start a Chat or View Conversation</div>
                </div>
                <button data-action="BackToContacts" class="btn btn-link d-md-none text-decoration-none">&larr;</button>
            </div>

            <div id="messagesContainer" class="flex-grow-1 overflow-auto p-3 bg-light" style="min-height: 50px;">
                <div class="text-center text-muted mt-5" id="defaultNoConvo">No conversation selected.</div>
            </div>
            <div id="sendMsgInput" class="mb-2" style="max-height: 325px;"></div>
        </div>
    </div>
</div>

<script>
    const data =  @Html.Raw(Json.Serialize(Model.Data))    
    console.log("data", data);

    const currentUserName = "@Model.UserName";

    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".chatTime").forEach(e => {
            const unformattedDate = e.dataset.time; 
            const date = DateProcessing(unformattedDate);
            e.innerHTML = date;
        })

    });

    toastr.options = {
        "closeButton": true,
        "positionClass": "toast-top-right",
        "timeOut": "500"
    };

    const clickEventListenerMethods = 
    {
        async DisplayChat(e)
        {
            if (window.innerWidth <= 768)
            {
                document.getElementById('chatPane').classList.remove('d-none');
                document.getElementById('contactsPane').classList.add('d-none');
            }

            try
            {
                const userId = e.target.dataset.userid;
                const contactName = e.target.dataset.contactname;
                const contactLastName = e.target.dataset.lastname;
                const profilePic = e.target.dataset.picture;

                let displayMsg = document.getElementById("messagesContainer");
                displayMsg.innerHTML = "";

                const dispayProfile = document.getElementById("chatHeader");
                dispayProfile.innerHTML = "";
                dispayProfile.innerHTML = `${profilePic ? `<img src="${profilePic}" class="rounded-circle me-2 border border-2 border-success clickable" data-action="ViewContactProfile" data-id="${userId}" style="width:55px; height: 55px; object-fit: cover;" />`
                                                     : `<div class="me-2 avatar-lg rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:44px;height:44px;" data-action="ViewContactProfile" data-id="${userId}">
                                                            ${contactName ? contactName.charAt(0).toUpperCase() : `?`}
                                                        </div>`}
                                            <div class="flex-grow-1">
                                                <strong class="clickable" data-action="ViewContactProfile" data-id="${userId}">${contactName.charAt(0).toUpperCase() +""+ contactName.slice(1) +" "+ contactLastName.charAt(0).toUpperCase() +""+ contactLastName.slice(1) }</strong>
                                                <div class="small text-muted" id="chatStatus">Last seen : date</div>
                                            </div>
                                            <button data-action="BackToContacts" class="btn btn-link d-md-none clickable text-decoration-none fs-2">&larr;</button>`;

                const response = await fetch(`/Home/GetAllChats?userId=${userId}`, { method : "GET"});
                const results = await response.json();
                if (results.error) return displayMsg.innerHTML = `<div class="text-center py-3">
                                                                     <div class="display-1 text-muted mb-1">
                                                                         <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                                                                     </div>
                                                                     <h6 class="mb-1">Technical Issue!<br />We currently attending to the issue.</h6>
                                                                     <p class="text-muted mb-4">Please refresh or try again later. </p>
                                                                     <button class="btn btn-primary btn-sm btn-lg action-btn" data-action="DisplayChat" data-userid="${userId}" data-contactname="${contactName}" data-lastname="${contactLastName}" data-picture="${profilePic}" >
                                                                         <i class="bi bi-plus-circle me-2"></i>Refresh
                                                                     </button>
                                                                  </div>`;

                let res = results.data; 
                res.map(msg =>{
                    if (msg.message === "DeletedChat") return displayMsg;
                    const isMine = msg.userName === currentUserName;
                    let userImage = "";
                    const div = document.createElement('div');
                    div.className = 'd-flex mb-3 ' + (isMine ? 'justify-content-end' : 'justify-content-start');
                    const newChat = msg.message === "NewChat";
                    if (profilePic) 
                    {
                        userImage = `<img src="${profilePic}" class="rounded-circle clickable" style="width:45px; height:45px; object-fit: cover;" data-action="ViewContactProfile" data-id="${userId}" />`;
                    }else {
                        userImage = `<div class='me-2 flex-shrink-0'>
                                        <div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center clickable'
                                            style='width:40px; height:40px; min-width:40px; min-height:40px;' data-action="ViewContactProfile" data-id="${userId}">
                                            ${contactName.charAt(0).toUpperCase()}
                                        </div>
                                      </div>`
                    }
                    if (newChat)
                    {
                         div.className = 'd-flex justify-content-center my-3';
                         div.innerHTML = `<div id="newChat" class="friend-alert-message text-center px-4 py-2">
                                              <p>You are now Friends with ${ contactName.charAt(0).toUpperCase() + contactName.slice(1) } Send a Message to Start a Chat.</p>
                                          </div>`;
                    }else {
                        div.innerHTML = `
                        <div class="d-flex align-items-end" style="max-width:75%;">
                            ${!isMine ? userImage  : '' }
                            <div style="max-width:100%;">
                                <div class="card shadow-sm ${isMine ? 'bg-primary text-white' : 'bg-white'}"
                                style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; max-width:100%;">
                                <div class="card-body p-2 small">${msg.message}</div>
                                </div>
                                <div class="small text-muted mt-1">
                                ${new Date(msg.sentOn).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                                </div>
                            </div>
                        </div>`;
                    }
                    displayMsg.appendChild(div);
                    displayMsg.scrollTop = messagesContainer.scrollHeight;
                    document.getElementById("sendMsgInput").innerHTML = `<form action="SendMessage" data-action="SendMsgForm" method="post" enctype="multipart/form-data" class="d-flex align-items-end">
                                                                             <input type="hidden" name="ToUserName" value="${contactName}"/>
                                                                             <input type="hidden" name="ToLastName" value="${contactLastName}"/>
                                                                             <input type="hidden" name="ToUserId" value="${userId}"/>
                                                                             <input type="hidden" name="ToUserProfilePicUrl" value="${profilePic}"/>
                                                                             <textarea id="messageInput" name="Message" class="form-control ms-2 me-2 mb-0" data-action="SendMessageTextArea" placeholder="Type a message..." maxlength="2000" autocomplete="off" style="height: 1rem;"></textarea>
                                                                             <button id="sendMsgBtn" class="btn btn-primary d-none h-50 rounded-pill px-3 mb-0 lh-2 flex-shrink-0" type="submit">
                                                                                  <i class="bi bi-send"></i>
                                                                             </button>
                                                                         </form>`;
                });
            }catch(error){
                document.getElementById("messagesContainer").innerHTML = `<div class="text-center py-3">
                                                                             <div class="display-1 text-muted mb-1">
                                                                                 <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                                                                             </div>
                                                                             <h6 class="mb-1">Technical Issue!<br />We currently attending to the issue.</h6>
                                                                             <p class="text-muted mb-4">Please refresh or try again later. </p>
                                                                             <button class="btn btn-primary btn-sm btn-lg action-btn" onclick="window.location.href='/Home/Chats';">
                                                                                 <i class="bi bi-plus-circle me-2"></i>Refresh
                                                                             </button>
                                                                          </div>`;
            }  
        },

        ViewContactProfile(e){
            const userId = e.target.dataset.id;
            const redirectUrl = '@Url.Action("ExternalUserProfile", "Home")';
            window.location.href = `${redirectUrl}/?userId=${userId}`;
        },

        BackToContacts(){
            document.getElementById('chatPane').classList.add('d-none');
            document.getElementById('contactsPane').classList.remove('d-none');
        }

    };

    const inputEventListenerMethod = 
    {
        SendMessageTextArea(e)
        {
            const sendMsgBtn = document.getElementById("sendMsgBtn");
            sendMsgBtn.classList.toggle("d-none", e.target.value.trim() === "");
            
            const msgContent = document.getElementById("messagesContainer");
            if (e.target.value.trim() != "")
            {
                e.target.style.height = Math.min(e.target.scrollHeight, 325) + 'px';
                msgContent.scrollTop = msgContent.scrollHeight;
            }else{
                e.target.style.height = 1 + 'rem';               
            }
        }
    };

    const submmissionEventListenerMethods = 
    {
        async SendMsgForm(e){
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const userId = formData.get("ToUserId");
            const message = formData.get("Message");
            const chatDisplay = document.getElementById("messagesContainer");            

            try
            {
                const response = await fetch(form.action, {method : "POST", body : new FormData(form)});
                const res = await response.json();

                if (res.success)
                {
                    const newChat = document.getElementById("newChat");
                    if (newChat) newChat.classList.add("d-none");

                    chatDisplay.insertAdjacentHTML("beforeend",  `<div class="d-flex justify-content-end">
                                                                        <div>                                                                      
                                                                            <div class="card shadow-sm bg-primary text-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; max-width:100%;">
                                                                                <div class="card-body p-2 small">${message}</div>
                                                                            </div>
                                                                            <div class="d-flex justify-content-between">
                                                                                <p class="d-flex small text-muted">now</p>
                                                                                <i class="bi bi-check text-success"></i>
                                                                            </div>
                                                                        </div>
                                                                    </div>`);
                    const el = chatDisplay.lastElementChild;
                    el.setAttribute('tabindex', '-1');
                    setTimeout(() => el.focus(), 0);

                    document.getElementById("messageInput").value = "";
                    document.getElementById("sendMsgBtn").classList.add("d-none");

                    const parent = document.getElementById("contactUsers");
                    const contact = document.getElementById(`contactId-${userId}`);
                    parent.prepend(contact);

                    const newMessage = document.getElementById(`message-${userId}`);
                    newMessage.innerHTML = `You: ${message}`;
                }else 
                {
                    const newChat = document.getElementById("newChat");
                    if (newChat) newChat.classList.add("d-none");

                    chatDisplay.insertAdjacentHTML("beforeend", `<div class="d-flex justify-content-end">
                                                                    <div>
                                                                        <div class="card shadow-sm bg-primary text-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; max-width:100%;">
                                                                            <div class="card-body p-2 small">${message}</div>
                                                                        </div>
                                                                        <div class="d-flex justify-content-between">
                                                                            <p class="d-flex small text-muted">now</p>
                                                                            <i class="bi bi-exclamation-circle-fill text-danger"></i>
                                                                        </div>
                                                                    </div>
                                                                  </div>`);
                    const el = chatDisplay.lastElementChild;
                    el.setAttribute('tabindex', '-1');
                    setTimeout(() => el.focus(), 0);

                    document.getElementById("messageInput").value = "";
                    document.getElementById("sendMsgBtn").classList.add("d-none");

                    const parent = document.getElementById("contactUsers");
                    const contact = document.getElementById(`contactId-${userId}`);
                    parent.prepend(contact);

                    const newMessage = document.getElementById(`message-${userId}`);
                    newMessage.innerHTML = `<i class="bi- bi-exclamation-circle-fill text-danger"></i> ${message}`;
                }
            }catch(error) {
                const newChat = document.getElementById("newChat");
                if (newChat) newChat.classList.add("d-none");

                chatDisplay.insertAdjacentHTML("beforeend",  `<div class="d-flex justify-content-end">
                                                                 <div>
                                                                    <div class="card shadow-sm bg-primary text-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; max-width:100%;">
                                                                        <div class="card-body p-2 small">${message}</div>
                                                                    </div>
                                                                    <div class="d-flex justify-content-between">
                                                                        <p class="d-flex small text-muted">now</p>
                                                                        <i class="bi bi-exclamation-circle-fill text-danger"></i>
                                                                    </div>
                                                                  </div>
                                                               </div>`);
                const el = chatDisplay.lastElementChild;
                el.setAttribute('tabindex', '-1');
                setTimeout(() => el.focus(), 0);

                document.getElementById("messageInput").value = "";
                document.getElementById("sendMsgBtn").classList.add("d-none");

                const parent = document.getElementById("contactUsers");
                const contact = document.getElementById(`contactId-${userId}`);
                parent.prepend(contact);

                const newMessage = document.getElementById(`message-${userId}`);
                newMessage.innerHTML = `<i class="bi- bi-exclamation-circle-fill text-danger"></i> ${message}`;
            }
          
        }
    }

    document.addEventListener("click", function(e) {
        const action = e.target.dataset.action;
        if (!action) return;
        const handler = clickEventListenerMethods[action];
        if (handler) handler(e);
    });

    document.addEventListener("input", function(e) {
        const action = e.target.dataset.action;
        if (!action) return;
        const handler = inputEventListenerMethod[action];
        if (handler) handler(e);
    });

    document.addEventListener("submit", function(e) {
        const action = e.target.dataset.action;
        if (!action) return;
        const handler = submmissionEventListenerMethods[action];
        if (handler) handler(e);
    });

    window.addEventListener('resize', function() {
        if (window.innerWidth <= 768)
        {
            document.getElementById('chatPane').classList.add('d-none');
        }
    });

    function DateProcessing(dateInfo)
    {
        if (dateInfo === "2/20/2020 8:20:20 PM") return null;
        let timeFormat = "";
        const utcDate = new Date(dateInfo);
        const nowSA = new Date(new Date().toLocaleString("en-US", { timeZone: "Africa/Johannesburg" }));
        const sentOnSA = new Date(utcDate.toLocaleString("en-US", { timeZone: "Africa/Johannesburg" }));

        const diffMs = nowSA - sentOnSA;
        const diffSeconds = Math.floor(diffMs / 1000);
        const diffMinutes = Math.floor(diffSeconds / 60);
        const diffHours = Math.floor(diffMinutes / 60);
        const diffDays = Math.floor(diffHours / 24);
        const diffWeeks = Math.floor(diffDays / 7);
        const diffMonths = Math.floor(diffDays / 30);
        const diffYears = Math.floor(diffDays / 365);

        if (diffSeconds < 60) {  timeFormat = "just now"; }
        else if (diffMinutes < 60) { timeFormat = `${diffMinutes}m`; }
        else if (diffHours < 24) { timeFormat = `${diffHours}h`; }
        else if (diffDays < 7) { timeFormat = `${diffDays}d`; }
        else if (diffWeeks < 5) { timeFormat = `${diffWeeks}w`; }
        else if (diffMonths <= 12) { timeFormat = `${diffMonths}mo`; }
        else if (diffYears <= 2) { timeFormat = `${diffYears}y`; }
        else {
            timeFormat = sentOnSA.toLocaleDateString();
        }

        return timeFormat;
    }



</script>


