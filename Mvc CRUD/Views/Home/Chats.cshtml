@using System.Security.Claims
@using Mvc_CRUD.Dto
@using Mvc_CRUD.Pagination
@using Newtonsoft.Json
@model PaginateResponse<List<ChatsDto>>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
<link rel="stylesheet" href="~/css/site.css" />

<div class="chat-app container-fluid h-100 d-flex p-0">
    <div class="row flex-fill w-100 shadow-sm">
        <div id="contactsPane" class="col-12 col-md-4 col-lg-3 border-end p-0">
            <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="mb-0">Chats</h5>
                <a class="btn btn-sm btn-outline-primary" href="#">New</a>
            </div>
            <div id="contacts" class="overflow-auto p-2" style="height: 28rem">
                <div class="list-group list-group-flush" id="contactUsers">
                    @if (!string.IsNullOrEmpty(Model.Error))
                    {
                        <div class="text-center py-3">
                            <div class="display-1 text-muted mb-1">
                                <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                            </div>
                            <h6 class="mb-1">Technical Issue!<br />We currently attending to the issue.</h6>
                            <p class="text-muted mb-4">Please refresh or try again later. </p>
                            <button class="btn btn-primary btn-sm btn-lg action-btn" onclick="window.location.href='/Home/Chats';">
                                <i class="bi bi-plus-circle me-2"></i>Refresh
                            </button>
                        </div>
                    }else if (Model.Data.Any())
                    {
                        @foreach (var contact in Model.Data)
                        {                            
                            <div class="d-flex gap-1 border-bottom py-3 chat-contact clickable" id="contactId-@contact.UserId" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                @if (!string.IsNullOrEmpty(contact.ProfilePicUrl))
                                {
                                    <img src="@contact.ProfilePicUrl" class="rounded-circle flex-shrink-0" style="width:45px; height:45px; object-fit: cover;" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl" />
                                }
                                else
                                {
                                    <div class="avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                            style="width:44px; height:44px; min-width:44px; min-height:44px;" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                        @(contact.UserName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-1 text-truncate" style="max-width: 70%;" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                            @(char.ToUpper(contact.UserName[0]) + contact.UserName.Substring(1)) @(char.ToUpper(contact.LastName[0]) + contact.LastName.Substring(1))
                                        </h6>
                                        @if (contact.UnreadMsgCount > 0 && contact.Sender != "CurrentUser")
                                        {
                                            <div id="unreadMsgIcon-@contact.UserId" class="avatar rounded-circle bg-primary text-white small align-items-center justify-content-center flex-shrink-0" style="width: 17px; height: 17px;">@contact.UnreadMsgCount</div>
                                        }
                                        else
                                        {
                                            <small class="text-muted flex-shrink-0 chatTime" id="contactMsgTime-@contact.UserId" data-time="@contact.SentOn" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl" style="white-space: nowrap; margin-left: 8px;"></small>
                                        }
                                        <div id="unreadMsgXIcon-@contact.UserId" class="avatar rounded-circle d-none bg-primary text-white small align-items-center justify-content-center flex-shrink-0" style="width: 17px; height: 17px;">0</div>
                                        <small class="text-muted flex-shrink-0 d-none chatTime" id="contactMsgXTime-@contact.UserId" data-time="@contact.SentOn" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl" style="white-space: nowrap; margin-left: 8px;"></small>
                                    </div>
                                    <div class="d-flex justify-content-between" id="message-@contact.UserId">
                                        <span class="mb-0 text-truncate text-muted small" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl">
                                            @contact.Message
                                        </span>
                                        @if (contact.Sender == "CurrentUser" && contact.Message != $"You are now Friends with {char.ToUpper(contact.UserName[0]) + contact.UserName.Substring(1)} Send a Message to Start a Chat.")
                                        {
                                            <i class="bi bi-check-all @(contact.Seen ? "text-primary" : "text-success")" id="contactMsgCheckIcon-@contact.UserId" data-action="DisplayChat" data-userid="@contact.UserId" data-contactname="@contact.UserName" data-lastname="@contact.LastName" data-picture="@contact.ProfilePicUrl"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }else {
                        <div class="alert alert-info text-center w-100">
                             No contacts yet.<br /> <a class="remove-link-underline" href="friendRequests">Add contacts</a>
                        </div>
                    }                                            
                </div>
            </div>
        </div>

        <div id="chatPane" class="col p-0 bg-light d-flex flex-column" style="height: 32rem; position: relative;">
            <div id="chatHeader" class="p-1 border-bottom d-flex bg-white align-items-center">                
                @if (!string.IsNullOrEmpty(Model.ProfilePicUrl))
                {
                    <img src="@Model.ProfilePicUrl" class="rounded-circle me-2 border border-2 border-success clickable" data-action="Test" style="width: 55px; height: 55px; object-fit: cover;" />
                }else {
                    <div class="me-2 avatar-lg rounded-circle bg-primary border border-2 border-success text-white d-flex align-items-center justify-content-center" style="width: 55px;height: 55px;">
                        @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "?")
                    </div>
                }              
                <div class="flex-grow-1">
                    <strong id="chatUserName">Select a contact</strong>
                    <div class="small text-muted" id="chatStatus">To Start a Chat or View Conversation</div>
                </div>
                <button data-action="BackToContacts" class="btn btn-link d-md-none text-decoration-none">&larr;</button>
            </div>

            <div id="messagesContainer" class="flex-grow-1 overflow-auto p-3 bg-light" style="min-height: 50px;">
                <div class="text-center text-muted mt-5" id="defaultNoConvo">No conversation selected.</div>
            </div>
            <div id="sendMsgInput" class="mb-2" style="max-height: 325px;"></div>
        </div>
    </div>
</div>

<script>
    const data =  @Html.Raw(Json.Serialize(Model.Data))    
    console.log("data", data);

    const currentUserName = "@Model.UserName";
    const currentUserProfilePic = "@Model.ProfilePicUrl";
    
    let activeChat = "";
    let randomNumber = 1;
    let test = false;

    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".chatTime").forEach(e => {
            const unformattedDate = e.dataset.time; 
            const date = DateProcessing(unformattedDate);
            e.innerHTML = date;
        })

    });

    toastr.options = {
        "closeButton": true,
        "positionClass": "toast-top-right",
        "timeOut": "500"
    };

    const clickEventListenerMethods = 
    {
        async DisplayChat(e)
        {
            if (window.innerWidth <= 768)
            {
                document.getElementById('chatPane').classList.remove('d-none');
                document.getElementById('contactsPane').classList.add('d-none');
            }

            try
            {
                const userId = e.target.dataset.userid;
                const contactName = e.target.dataset.contactname;
                const contactLastName = e.target.dataset.lastname;
                const profilePic = e.target.dataset.picture;

                let displayMsg = document.getElementById("messagesContainer");
                displayMsg.innerHTML = "";

                const dispayProfile = document.getElementById("chatHeader");
                dispayProfile.innerHTML = "";
                dispayProfile.innerHTML = `${profilePic ? `<img src="${profilePic}" class="rounded-circle me-2 border border-2 border-success clickable" data-action="ViewContactProfile" data-id="${userId}" style="width:55px; height: 55px; object-fit: cover;" />`
                                                     : `<div class="me-2 avatar-lg rounded-circle bg-primary border border-2 border-success text-white d-flex align-items-center justify-content-center" style="width: 55px;height: 55px;" data-action="ViewContactProfile" data-id="${userId}">
                                                            ${contactName ? contactName.charAt(0).toUpperCase() : `?`}
                                                        </div>`}
                                            <div class="flex-grow-1">
                                                <strong class="clickable" data-action="ViewContactProfile" data-id="${userId}">${contactName.charAt(0).toUpperCase() +""+ contactName.slice(1) +" "+ contactLastName.charAt(0).toUpperCase() +""+ contactLastName.slice(1) }</strong>
                                                <div class="small text-muted" id="chatStatus">Last seen : date</div>
                                            </div>
                                            <button data-action="BackToContacts" class="btn btn-link d-md-none clickable text-decoration-none fs-2">&larr;</button>`;

                const response = await fetch(`/Home/GetAllChats?userId=${userId}`, { method : "GET"});
                const results = await response.json();
                if (results.error) return displayMsg.innerHTML = `<div class="text-center py-3">
                                                                     <div class="display-1 text-muted mb-1">
                                                                         <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                                                                     </div>
                                                                     <h6 class="mb-1">Technical Issue!<br />We currently attending to the issue.</h6>
                                                                     <p class="text-muted mb-4">Please refresh or try again later. </p>
                                                                     <button class="btn btn-primary btn-sm btn-lg action-btn" data-action="DisplayChat" data-userid="${userId}" data-contactname="${contactName}" data-lastname="${contactLastName}" data-picture="${profilePic}" >
                                                                         <i class="bi bi-plus-circle me-2"></i>Refresh
                                                                     </button>
                                                                  </div>`;

                renderChats(results.data, userId, contactName, contactLastName, profilePic);

                const unreadMsgIcon = document.getElementById(`unreadMsgIcon-${userId}`);
                const unreadMsgXIcon = document.getElementById(`unreadMsgXIcon-${userId}`);
                const displayDate = document.getElementById(`contactMsgXTime-${userId}`);
                if (unreadMsgIcon)
                {
                    unreadMsgIcon.classList.add("d-none");
                    displayDate.classList.remove("d-none");
                    const recentTime = document.getElementById(`newContactTime-${userId}`);
                    if (recentTime) recentTime.classList.add("d-none");
                }

                if (!unreadMsgXIcon.classList.contains("d-none")) 
                {
                    unreadMsgXIcon.classList.add("d-none"); 
                    displayDate.classList.remove("d-none");
                    const recentTime = document.getElementById(`newContactTime-${userId}`);
                    if (recentTime) recentTime.classList.add("d-none");
                }            
                
                activeChat = userId;

            }catch(error){
                document.getElementById("messagesContainer").innerHTML = `<div class="text-center py-3">
                                                                             <div class="display-1 text-muted mb-1">
                                                                                 <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                                                                             </div>
                                                                             <h6 class="mb-1">Technical Issue!<br />We currently attending to the issue.</h6>
                                                                             <p class="text-muted mb-4">Please refresh or try again later. </p>
                                                                             <button class="btn btn-primary btn-sm btn-lg action-btn" onclick="window.location.href='/Home/Chats';">
                                                                                 <i class="bi bi-plus-circle me-2"></i>Refresh
                                                                             </button>
                                                                          </div>`;
            }  
        },

        ViewContactProfile(e){
            const userId = e.target.dataset.id;
            const redirectUrl = '@Url.Action("ExternalUserProfile", "Home")';
            window.location.href = `${redirectUrl}/?userId=${userId}`;
        },

        BackToContacts(){
            document.getElementById('chatPane').classList.add('d-none');
            document.getElementById('contactsPane').classList.remove('d-none');
        }

    };

    const inputEventListenerMethod = 
    {
        async SendMessageTextArea(e)
        {
            const friendName = e.target.dataset.name;
            const sendMsgBtn = document.getElementById("sendMsgBtn");
            sendMsgBtn.classList.toggle("d-none", e.target.value.trim() === "");
            
            const msgContent = document.getElementById("messagesContainer");
            if (e.target.value.trim() != "")
            {
                e.target.style.height = Math.min(e.target.scrollHeight, 325) + 'px';
                msgContent.scrollTop = msgContent.scrollHeight;

                await connection.invoke('IsTypingMessage', friendName);
            }else{
                e.target.style.height = 1 + 'rem';               
            }
        }

    };

    const submmissionEventListenerMethods = 
    {
        async SendMsgForm(e){
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const userId = formData.get("ToUserId");
            const userName = formData.get("ToUserName");
            const message = formData.get("Message");
            const lastName = formData.get("ToLastName");
            const profilePic = formData.get("ToUserProfilePicUrl");
            const chatDisplay = document.getElementById("messagesContainer");            

            try
            {
                const response = await fetch(form.action, {method : "POST", body : new FormData(form)});
                const res = await response.json();

                test = true;

                if (res.success)
                {
                    const newChat = document.getElementById("newChat");
                    if (newChat) newChat.classList.add("d-none");

                    const dateNow = new Date();
                    randomNumber = Math.floor(Math.random() * 250) + 1;
                    const newMsgInfo = `<div class="d-flex justify-content-end mt-2 text-white no-word-break" >
                                         <small class="justnow" data-msgtime="${dateNow}">now</small>
                                         <i class="bi bi-check" id="msgCheckIcon-${randomNumber}"></i>
                                     </div>`;

                    chatDisplay.insertAdjacentHTML("beforeend", 
                        `<div class="d-flex mb-3 justify-content-end"> 
                            <div class="card shadow-sm bg-primary text-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap;">
                                <div class="card-body d-flex gap-1 p-2 small">${message + newMsgInfo}</div>
                            </div>
                        </div>`);

                    const el = chatDisplay.lastElementChild;
                    el.setAttribute('tabindex', '-1');
                    setTimeout(() => el.focus(), 0);

                    const msgContent = document.getElementById("messagesContainer");
                    msgContent.scrollTop = msgContent.scrollHeight;

                    document.getElementById(`messageInput-${userId}`).value = "";
                    document.getElementById("sendMsgBtn").classList.add("d-none");

                    const parent = document.getElementById("contactUsers");
                    const contact = document.getElementById(`contactId-${userId}`);
                    parent.prepend(contact);

                    const displayedDate = document.getElementById(`contactMsgTime-${userId}`);
                    if (displayedDate) displayedDate.textContent = "now";

                    document.getElementById(`message-${userId}`).innerHTML = 
                        `<span class="text-muted small text-truncate">${message}</span>
                         <i class="bi bi-check text-success" id="newContactCheckIcon-${userId}" data-action="DisplayChat" data-userid="${userId}" data-contactname="${userName}" data-lastname="${lastName}" data-picture="${profilePic}"></i>`;
                     
                    await connection.invoke('SendPrivateMessage', userName, message, userId); 

                    setInterval(() => { 
                        document.querySelectorAll(".justnow").forEach(e => {
                            e.textContent = chatsDate(dateNow)
                            displayedDate.textContent = chatsDate(dateNow);
                        }
                    )}, 61_000)

                }else 
                {
                    const newChat = document.getElementById("newChat");
                    if (newChat) newChat.classList.add("d-none");

                    const msgInfoError = `<div class="d-flex justify-content-end mt-2 no-word-break">
                                              <small>now</small>
                                              <i class="bi bi-exclamation-circle-fill text-danger"></i>
                                          </div>`;

                    chatDisplay.insertAdjacentHTML("beforeend", 
                        `<div class="d-flex mb-3 justify-content-end">
                            <div>
                                <div class="card shadow-sm bg-primary text-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap;">
                                    <div class="card-body d-flex gap-1 p-2 small">${message + msgInfoError}</div>
                                </div>                                                                      
                            </div>
                        </div>`);

                    const el = chatDisplay.lastElementChild;
                    el.setAttribute('tabindex', '-1');
                    setTimeout(() => el.focus(), 0);

                    const msgContent = document.getElementById("messagesContainer");
                    msgContent.scrollTop = msgContent.scrollHeight;

                    document.getElementById(`messageInput-${userId}`).value = "";
                    document.getElementById("sendMsgBtn").classList.add("d-none");

                    const parent = document.getElementById("contactUsers");
                    const contact = document.getElementById(`contactId-${userId}`);
                    parent.prepend(contact);

                    const contactMsgCheckIcon = document.getElementById(`contactMsgCheckIcon-${userId}`);
                    if (contactMsgCheckIcon) contactMsgCheckIcon.classList.add("d-none");

                    const contactMsg = document.getElementById(`message-${userId}`);
                    contactMsg.innerHTML = "";
                    contactMsg.innerHTML = `<span class="text-muted text-truncate small">${message}</span>
                                            <i class="bi- bi-exclamation-circle-fill text-danger"></i>`;
                    
                }
            }catch(error) {               
                const newChat = document.getElementById("newChat");
                if (newChat) newChat.classList.add("d-none");

                const msgInfoExceptionError = `<div class="d-flex justify-content-end mt-2 no-word-break">
                                                   <small>now</small>
                                                   <i class="bi bi-exclamation-circle-fill text-danger"></i>
                                               </div>`;

                chatDisplay.insertAdjacentHTML("beforeend",  
                    `<div class="d-flex mb-3 justify-content-end">
                        <div class="card shadow-sm bg-primary text-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; max-width:100%;">
                            <div class="card-body d-flex gap-1 p-2 small">${message + msgInfoExceptionError}</div>
                        </div>
                    </div>`);

                const el = chatDisplay.lastElementChild;
                el.setAttribute('tabindex', '-1');
                setTimeout(() => el.focus(), 0);

                const msgContent = document.getElementById("messagesContainer");
                msgContent.scrollTop = msgContent.scrollHeight;

                document.getElementById(`messageInput-${userId}`).value = "";
                document.getElementById("sendMsgBtn").classList.add("d-none");

                const parent = document.getElementById("contactUsers");
                const contact = document.getElementById(`contactId-${userId}`);
                parent.prepend(contact);

                const newMessage = document.getElementById(`message-${userId}`);
                newMessage.innerHTML = "";
                newMessage.innerHTML = `<span class="text-muted text-truncate small">${message}</span>
                                        <i class="bi bi-exclamation-circle-fill text-danger"></i>`;
            }
          
        }
    }

    document.addEventListener("click", function(e) {
        const action = e.target.dataset.action;
        if (!action) return;
        const handler = clickEventListenerMethods[action];
        if (handler) handler(e);
    });

    document.addEventListener("input", function(e) {
        const action = e.target.dataset.action;
        if (!action) return;
        const handler = inputEventListenerMethod[action];
        if (handler) handler(e);
    });

    document.addEventListener("submit", function(e) {
        const action = e.target.dataset.action;
        if (!action) return;
        const handler = submmissionEventListenerMethods[action];
        if (handler) handler(e);
    });

    window.addEventListener('resize', function() {
        if (window.innerWidth <= 768)
        {
            document.getElementById('chatPane').classList.add('d-none');
        }
    });


    function renderChats(data, userId, contactName, contactLastName, profilePicture)
    {
        let displayMsg = document.getElementById("messagesContainer");
        displayMsg.innerHTML = "";

        data.map(msg => {
            if (msg.message === "DeletedChat") return displayMsg;
            const isMine = msg.userName === currentUserName;
            let userImage = "";            
            const div = document.createElement('div');
            div.className = 'd-flex mb-3 ' + (isMine ? 'justify-content-end' : 'justify-content-start');
            const newChat = msg.message === "NewChat";
            profilePicture ? userImage = `<img src="${profilePicture}" class="rounded-circle me-1 clickable" style="width: 45px; height: 45px; object-fit: cover;" data-action="ViewContactProfile" data-id="${userId}" />`
                           : userImage = `<div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center clickable'
                                               style='width:40px; height:40px; min-width:40px; min-height:40px;' data-action="ViewContactProfile" data-id="${userId}">
                                                   ${contactName.charAt(0).toUpperCase()}
                                          </div>`;

            if (newChat)
            {
                div.className = 'd-flex justify-content-center my-3';
                div.innerHTML = `<div id="newChat" class="friend-alert-message text-center px-4 py-2">
                                    <p>You are now Friends with ${ contactName.charAt(0).toUpperCase() + contactName.slice(1) } Send a Message to Start a Chat.</p>
                                </div>`;
            }else {
                let sentByMe = "";
                let seenMsgCheckIcon = "";

                if (isMine)
                {
                    {msg.seen ? seenMsgCheckIcon = '<i class="bi bi-check-all" style="color : #00FFFF"></i>'
                              : seenMsgCheckIcon = '<i class="bi bi-check-all text-white"></i>'}

                    sentByMe = `<div class="d-flex justify-content-end mt-2 no-word-break">
                                    <small class="small text-white msgTime" data-msgtime="${msg.sentOn}"></small>
                                    ${seenMsgCheckIcon}
                                </div>`
                }
                const msgInfo = isMine ? sentByMe : `<div class="small text-muted mt-2 msgTime no-word-break" data-msgtime="${msg.sentOn}"></div>`;

                div.innerHTML = `
                    <div class="d-flex align-items-end" style="max-width:75%;">
                        ${!isMine ? userImage  : '' }
                        <div class="mb-2" style="max-width:100%;">
                            <div class="card shadow-sm ${isMine ? 'bg-primary text-white' : 'bg-white'}" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap;">
                                <div class="card-body d-flex gap-1 p-2 small">${msg.message + msgInfo}</div>                            
                            </div> 
                        </div>
                    </div>`;

            }           

            displayMsg.appendChild(div);
            displayMsg.scrollTop = messagesContainer.scrollHeight;
            document.getElementById("sendMsgInput").innerHTML = `<form action="SendMessage" data-action="SendMsgForm" method="post" enctype="multipart/form-data" class="d-flex align-items-end">
                                                                    <input type="hidden" name="ToUserName" value="${contactName}"/>
                                                                    <input type="hidden" name="ToLastName" value="${contactLastName}"/>
                                                                    <input type="hidden" name="ToUserId" value="${userId}"/>
                                                                    <input type="hidden" name="ToUserProfilePicUrl" value="${profilePicture}"/>
                                                                    <textarea id="messageInput-${userId}" name="Message" class="form-control ms-2 me-2 mb-0" data-action="SendMessageTextArea"
                                                                        data-name="${contactName}" placeholder="Type a message..." maxlength="2000" autocomplete="off" style="height: 1rem;"></textarea>
                                                                    <button id="sendMsgBtn" class="btn btn-primary d-none h-50 rounded-pill px-3 mb-0 lh-2 flex-shrink-0" type="submit">
                                                                        <i class="bi bi-send"></i>
                                                                    </button>
                                                                </form>`;
            document.querySelectorAll(".msgTime").forEach(e => {
                const unformattedDate = e.dataset.msgtime;
                const date = chatsDate(unformattedDate);
                e.innerHTML = date;
            })

        });
    }

    function chatsDate(dateData)
    {
        if (!dateData || dateData === "2020-02-20T20:20:20") return null;

        const date = new Date(dateData);
        if (Number.isNaN(date.getTime())) return null;        

        const seconds = Math.floor( (Date.now() - date.getTime()) / 1000 );
        if (seconds < 60) return "now";

        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m`;

        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours}h`;

        const days = Math.floor(hours / 24);
        if (days < 7) return `${days}d`;

        // const weeks = Math.floor(days / 7);
        // if (weeks < 5) return `${weeks}w`;

        // const months = Math.floor(days / 30);
        // if (months < 12) return `${months}mo`;

        // const years = Math.floor(days / 365);
        // return `${years}y`;    
        
        const dateParts = new Intl.DateTimeFormat("en-ZA", {
            month: "long",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
            timeZone: "Africa/Johannesburg"
        }).formatToParts(date);

        const monthOnly = dateParts.find(x => x.type === "month").value;
        const dayOnly = dateParts.find(x => x.type === "day").value;
        const hoursOnly = dateParts.find(x => x.type === "hour").value;
        const minutesOnly = dateParts.find(x => x.type === "minute").value;
        const period = hoursOnly >= 12 ? "PM" : "AM";
        return `${monthOnly} ${dayOnly} at ${hoursOnly}:${minutesOnly} ${period}`;
    }

    function DateProcessing(dateInfo)
    {
        if (!dateInfo || dateInfo === "2/20/2020 8:20:20 PM") return null;

        const match = dateInfo.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4}) (\d{1,2}):(\d{2}):(\d{2}) (AM|PM)$/i);
        if (!match) return null;

        const [, month, day, year, hour, minute, second, period] = match;
        let hours = Number(hour) % 12;
        if (period.toUpperCase() === "PM") hours += 12;
        const timestamp = Date.UTC( Number(year), Number(month) - 1, Number(day), hours, Number(minute), Number(second) );

        const seconds = Math.floor((Date.now() - timestamp) / 1000);
        if (seconds < 0) return "now";
        if (seconds < 60) return "now";

        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m`;

        const hoursAgo = Math.floor(minutes / 60);
        if (hoursAgo < 24) return `${hoursAgo}h`;

        const days = Math.floor(hoursAgo / 24);
        if (days < 7) return `${days}d`;

        const weeks = Math.floor(days / 7);
        if (weeks < 5) return `${weeks}w`;

        const months = Math.floor(days / 30);
        if (months < 12) return `${months}mo`;

        const years = Math.floor(days / 365);
        return `${years}y`;
    }

    const connection = new signalR.HubConnectionBuilder().withUrl('/signalRHub').withAutomaticReconnect().build();
    connection.start().catch(err => console.error(err.toString()));

    connection.on("TypingMessage",(userId) => {
        const textInput = document.getElementById(`messageInput-${userId}`);
        if (textInput)
        {
            textInput.placeholder = "Typing.....";
            textInput.classList.add("blinker");

            let isActive = true;
            setInterval(() => {
                if (!isActive) return;
                textInput.placeholder = "Type a message...";
                textInput.classList.remove("blinker");
                isActive = false;
            }, 8000);
        }        
    });

    connection.on("MessageConfirmation", (ToUserId) =>  {
        const checkIcon = document.getElementById(`msgCheckIcon-${randomNumber}`);
        checkIcon.classList.remove("bi-check");
        checkIcon.classList.add("bi-check-all");

        const contactCheckIcon = document.getElementById(`newContactCheckIcon-${ToUserId}`)
        contactCheckIcon.classList.remove("bi-check");
        contactCheckIcon.classList.add("bi-check-all");

        const liveTexting = document.getElementById(`messageInput-${ToUserId}`);
        if (liveTexting)
        {
            contactCheckIcon.classList.remove("text-success");
            contactCheckIcon.classList.add("text-primary");

            checkIcon.classList.remove("text-white");
            checkIcon.style.color = `#00FFFF`;
        }
    });

    connection.on("ReceiveMessage", async (fromUser, Message, userId, ProfilePic, lastName) => {
        const justRNow = new Date();
        const parent = document.getElementById("contactUsers");
        const contact = document.getElementById(`contactId-${userId}`);
        parent.prepend(contact);

        const displayedDate = document.getElementById(`contactMsgTime-${userId}`);
        if (displayedDate) displayedDate.classList.add("d-none");

        const unreadMsgIcon = document.getElementById(`unreadMsgIcon-${userId}`);
        const unreadMsgXIcon = document.getElementById(`unreadMsgXIcon-${userId}`);
        if (unreadMsgXIcon)
        {
            if (unreadMsgIcon) 
            {
                const currentUnreadMsgCount =  Number(unreadMsgIcon.innerHTML)
                unreadMsgIcon.innerHTML = currentUnreadMsgCount + 1;
            }else{
                const currentNewMsgCount =Number(unreadMsgXIcon.innerHTML)
                unreadMsgXIcon.classList.remove("d-none");
                unreadMsgXIcon.innerHTML = currentNewMsgCount + 1;
            }           
        }
         
        document.getElementById(`message-${userId}`).innerHTML = 
          `<small class="text-muted text-truncate">${Message}</small>
           <small class="text-muted flex-shrink-0 receivedNow" id="newContactTime-${userId}" data-action="DisplayChat" data-userid="${userId}" data-contactname="${fromUser}" data-lastname="${lastName}" data-picture="${ProfilePic}" style="white-space: nowrap; margin-left: 8px;">now</small>`;

        const displayNewDate = document.getElementById(`contactMsgXTime-${userId}`);
        const liveMsgDisplay = document.getElementById("messagesContainer");
        if (activeChat === userId)
        {
            document.addEventListener("click", function (e) {
                if (unreadMsgIcon) unreadMsgIcon.classList.add("d-none");
                if (unreadMsgXIcon) unreadMsgXIcon.classList.add("d-none");
                
                document.getElementById(`newContactTime-${userId}`).classList.add("d-none");
                displayNewDate.classList.remove("d-none");
                displayNewDate.textContent = chatsDate(justRNow);
            });

            await fetch(`ConvertMessageToSeen?userId=${userId}`, {method : "POST"});

            const liveMsgInfo = `<div class="d-flex justify-content-end mt-2">
                                     <small class="receivedNow" id="newTime-${userId}">now</small>
                                 </div>`;

            liveMsgDisplay.insertAdjacentHTML("beforeend", `<div class="d-flex justify-content-start mb-3">
                                                                <div class="d-flex align-items-end" style="max-width:75%;">
                                                                    ${ProfilePic ? `<img src="${ProfilePic}" class="rounded-circle clickable" style="width:45px; height:45px; object-fit: cover;" data-action="ViewContactProfile" data-id="${userId}" />`
                                                                                    : `<div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center clickable' data-action="ViewContactProfile" data-id="${userId}" style='width:40px; height:40px; min-width:40px; min-height:40px;'>
                                                                                            ${fromUser.charAt(0).toUpperCase()}
                                                                                       </div>`}
                                                                    <div class="mb-2" style="max-width:100%;">
                                                                        <div class="card shadow-sm bg-white" style="word-break: break-all; overflow-wrap: break-word; white-space: pre-wrap; max-width:100%;">
                                                                            <div class="card-body d-flex gap-1 small p-2">${Message + liveMsgInfo}</div>
                                                                        </div>                                                                       
                                                                    </div>
                                                                </div>
                                                            </div>`);
            liveMsgDisplay.scrollTop = liveMsgDisplay.scrollHeight;           
        }

        setInterval(() => {
            document.querySelectorAll(".receivedNow").forEach(e =>{
                e.textContent = chatsDate(justRNow);
                displayNewDate.textContent = chatsDate(justRNow);
            });
        }, 61_000);

    });


</script>


