@using Mvc_CRUD.Pagination
@model PaginateResponse<List<Mvc_CRUD.Dto.PostsDto>>

@{
    ViewData["Title"] = "ChatUp-Home";
    var userAgent = Context.Request.Headers["User-Agent"].ToString();
    bool isMobile = userAgent.Contains("Android", StringComparison.OrdinalIgnoreCase) || userAgent.Contains("iPhone", StringComparison.OrdinalIgnoreCase)
                    || userAgent.Contains("iPad", StringComparison.OrdinalIgnoreCase) || userAgent.Contains("Mobile", StringComparison.OrdinalIgnoreCase)
                    || userAgent.Contains("Mobi", StringComparison.OrdinalIgnoreCase);
}

<link href="~/css/site.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 
<div class="container mt-4 col-10">
    <div class="row">
        <div class="col-md-8 mx-auto">          
            <div class="card shadow-sm border-0 rounded-4 mb-2 gap-0">
                <div class="card-body">
                <div class="d-flex align-items-center gap-1 mb-2">                    
                    @if (!string.IsNullOrEmpty(Model.ProfilePicUrl))
                    {
                        <img src="@Model.ProfilePicUrl" class="rounded-circle me-2 d-flex align-items-center justify-content-center"
                             style="width:45px; height:45px; object-fit: cover; cursor : pointer" />
                    }
                    else
                    {
                        <div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center'
                             style='width:45px; height:45px; font-size: 17px; font-weight: bold;'>
                            @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "XX")
                        </div>
                    }
                    <button type="button" class="form-control text-start text-muted bg-light border-0 rounded-pill py-2" data-action="ToggleCreatePostCard">
                        What's on your mind, @(!string.IsNullOrEmpty(Model.UserName) ? char.ToUpper(Model.UserName[0]) + Model.UserName.Substring(1) : "User")
                    </button>
                </div>
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-light fw-bold bi bi-camera-video text-danger" data-action="ToggleCreatePostCard"> Live</button>
                    <button type="button" class="btn btn-light fw-bold" data-action="ToggleCreatePostCard">
                        <i class="bi bi-images text-success"></i> Photo
                    </button>
                    <button type="button" class="btn btn-light fw-bold" data-action="ToggleCreatePostCard">
                        <i class="bi bi-emoji-smile text-warning"></i> Feeling
                    </button>
                </div>
            </div>
            </div>
            <br />            
            <div id="justPosted"></div>           
            @if(Model.Data != null && Model.Data.Any())
            {
                @foreach (var post in Model.Data)
                { 
                    <div class="card shadow-sm border-0 rounded-4 mb-4 gap-0" id="">
                        <div class="card-body p-0">
                            <div class="d-flex align-items-center mb-1 p-2">
                                @if(!string.IsNullOrEmpty(post.UserImageUrl))
                                {
                                    <img src="@post.UserImageUrl" id="viewProfile" data-id="@post.UserId" 
                                      class="rounded-circle clickable" style="width: 45px;height: 45px;object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary text-white d-flex clickable align-items-center justify-content-center fw-bold" style="width: 45px;height: 45px;" 
                                      id="viewProfile" data-id="@post.UserId">@(post.UserName.Substring(0,1).ToUpper())
                                    </div>
                                }
                                <div class="col ms-1">
                                    <h6 class="mb-0 fw-bold">
                                        @(char.ToUpper(@post.UserName[0]) + @post.UserName.Substring(1)) @(char.ToUpper(@post.LastName[0]) + @post.LastName.Substring(1))</h6>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>@post.CreatedOn.ToString("MMM dd, yyyy • h:mm tt")
                                    </small>
                                </div>
                                <div class="dropdown ms-auto" id="dropdown-@post.Id">
                                    <button class="btn fw-bolder" type="button" data-action="ToggleDropDownMenu" data-id="@post.Id">
                                        &#8230;
                                    </button>
                                    <ul class="dropdown-menu custom-dropdown" id="dropDownMenu-@post.Id">
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Edit Post</a></li>
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                    </ul>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(post.PostBgColour))
                            {
                                <div class="post-bgcard" style="background-color: @post.PostBgColour">
                                    <div class="post-bgtext p-2">@post.Content</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(post.Content) && string.IsNullOrEmpty(post.PostBgColour) )
                            {
                                <span class="p-2">@post.Content</span>
                            }
                            @if (!string.IsNullOrEmpty(post.ImageContentUrl))
                            {
                                <img src="@post.ImageContentUrl" class="post-image img-fluid rounded mb-0" style="width: 100%; max-height: 450px; object-fit: cover;" alt="Post image">
                            }
                            <div class="d-flex justify-content-between text-muted">
                                <div>
                                    <span class="me-3" id="LikesContainer-@post.Id"> 
                                        @if (@post.PostLikes?.Count > 0)
                                        {
                                            <span id="totalLikes-@post.Id">@post.PostLikes?.Count</span>  
                                            <i class="bi bi-heart-fill text-danger me-1"></i>  
                                        }                                   
                                    </span>
                                </div>
                                <div>
                                    <span>
                                        @if (post.TotalComments > 0)
                                        {
                                            <span id="totalComments-@post.Id">@post.TotalComments</span>
                                        }
                                        <span id="firstComment-@post.Id"></span>
                                        <i class="bi bi-chat me-1"></i>
                                    </span>
                                    <span>
                                        @if (@post.Shares > 0)
                                        {
                                            <span>@post.Shares</span>
                                        }
                                        <i class="fa-solid fa-share"></i>
                                    </span>
                                </div>
                            </div>
                            <hr class="dropdown mt-2 mb-0">
                            <div class="d-flex justify-content-around mb-1 p-2">
                                @{
                                    var likedByMe = post.PostLikes?.Any(x => x.Username == Model.UserName);
                                    if (likedByMe == true)
                                    {
                                        <button class="btn btn-link w-100 me-2 text-decoration-none text-muted like-btn" data-action="Like" data-id="@post.Id">
                                              <i class="bi-hand-thumbs-up-fill" data-action="Like" data-id="@post.Id" style="color: #0d6efd"></i> like
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-link w-100 me-2 text-decoration-none text-muted like-btn" data-action="Like" data-id="@post.Id">
                                             <i class="bi-hand-thumbs-up" data-action="Like" data-id="@post.Id"></i> like
                                        </button>
                                    }
                                }
                                <button class="btn btn-link w-100 me-2 text-decoration-none text-muted" data-action="CommentsToggle" data-id="@post.Id">
                                    <i class="bi bi-chat" data-action="CommentsToggle" data-id="@post.Id"></i> Comment
                                </button>
                                <button class="btn btn-link w-100 text-decoration-none text-muted" data-action="Share" data-id="@post.Id">
                                    <i class="bi  bi-share"></i> Share
                                </button>
                            </div>

                            @* *************** Comments *********** *@
                            @if (isMobile)
                            {
                                <div class="overlay" id="overlay-@post.Id"></div>
                                <div class="comment-pop-up" id="commentsPopUp-@post.Id">
                                    <div class="dragHandle" id="dragHandle-@post.Id"></div>
                                    <div class="overflow-auto mt-4 w-100 " style="max-height: 340px;">
                                        <div id="displayMobileComments-@post.Id"></div>
                                         <div id="sendCommentBtn-@post.Id"></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="reply-group-@post.Id collapse mt-3 mb-2" id="commentsContents-@post.Id">
                                    <div class="overflow-auto mb-2 p-2" id="displayer-@post.Id" style="max-height: 350px"></div> 
                                    <div id="sendCommentBtn-@post.Id"></div>
                                </div>                               
                            }
                        </div>
                    </div>                       
                }
                    <div id="morePostContent"></div>
                    <div id="observer"></div>
            }else if(Model.Error != null)
            {
                <div class="text-center py-5">
                    <div class="display-1 text-muted mb-3">
                        <i class="bi bi-exclamation-triangle text-danger"></i>
                    </div>
                    <h3 class="mb-3">Technical Issue!<br />We currently attending to the issue.</h3>
                    <p class="text-muted mb-4">Please refresh or try again later. </p>
                    <button class="btn btn-primary btn-lg action-btn" onclick="window.location.reload();">
                        <i class="bi bi-plus-circle me-2"></i>Refresh
                    </button>
                </div>
            }else {
               <div class="text-center py-5">
                   <div class="display-1 text-muted mb-3">
                       <i class="bi bi-chat-square-text"></i>
                   </div>
                   <h3 class="mb-3">NO Post Yet Incoming Soon....................</h3>
                   <p class="text-muted mb-4">Exciting news : thought provoking post are on the way wait to be woooowed </p>
                   <button class="btn btn-primary btn-lg action-btn" data-action="ToggleCreatePostCard">
                        <i class="bi bi-plus-circle me-2"></i>Create First Post
                   </button>
               </div>
            }
        </div>
    </div>    
</div>


@* --------Create Post Card--------- *@
<div class="d-none create-post-overlay" id="createPostOverlay">
    <div class="overflow-auto col-md-5 mx-auto" style="max-height: 540px;">  
        <div class="card shadow-sm border-0 rounded-4 mb-2 gap-0">
            <div class="card-body">
                <div class="d-flex justify-content-center position-relative mb-3">
                    <h5 class="text-muted fw-bold">Create Post</h5>
                    <button type="button" class="btn-close position-absolute end-0 me-3" data-action="ToggleClosePostCard"></button>
                </div>
                <hr class="dropdown mt-2 mb-2">
                <form asp-controller="Home" asp-action="CreatePost" method="post" data-action="PostForm" id="postForm" enctype="multipart/form-data">
                    <div class="col align-items-center gap-2 mb-2">
                        <div class="d-flex gap-1">
                            @if(!string.IsNullOrEmpty(Model.ProfilePicUrl))
                            {
                                <img src="@Model.ProfilePicUrl" class="rounded-circle" style="width: 40px;height: 40px;object-fit: cover;" />                                     
                            }else{
                                <div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center' style='width:40px; height:40px; min-width:40px; min-height:40px;'>
                                    @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "User")
                                </div>
                            }                                                  
                            <span class="fw-bolder mt-1">
                                @(!string.IsNullOrEmpty(Model.UserName) ?char.ToUpper(Model.UserName[0]) + Model.UserName.Substring(1) : "User")
                                @(!string.IsNullOrEmpty(Model.LastName) ? char.ToUpper(Model.LastName[0]) + Model.LastName.Substring(1)  : "User")
                            </span> 
                        </div>  
                        <select class="form-select form-select-sm w-auto mt-1" name="PostScope">
                            <option selected value="Public"><i class="bi bi-globe"></i> Public</option>
                            <option value="Friends"><i class="bi bi-people"></i> Friends</option>
                            <option value="Only me"><i class="bi bi-lock"></i> Only me</option>
                        </select>                    
                    </div>

                    <textarea id="textAreaBackground" name="Content" class="form-control text-center mb-2" rows="5" placeholder="What's on your mind?" 
                                style="resize: none; font-size: 1.1rem; font-weight : bold;"></textarea>
                    <button type="button" id="mainButton" data-action="PostColourBtn" class="btn btn-primary mb-2">Colour</button>
                    <div id="colourButton" class="d-none d-flex gap-1 mb-3">
                        <input type="hidden" id="selectedColor" name="PostBgColour" />
                        <button type="button" class="btn btn-danger rounded-circle circle-btn" data-action="SelectedPostBgColour" data-colour="red"></button>
                        <button type="button" class="btn btn-success rounded-circle circle-btn" data-action="SelectedPostBgColour" data-colour="green"></button>
                        <button type="button" class="btn btn-primary rounded-circle circle-btn" data-action="SelectedPostBgColour" data-colour="blue"></button>
                        <button type="button" class="btn rounded-circle circle-btn" 
                            data-action="SelectedPostBgColour" data-colour="red" style="background-color : deeppink"></button>
                        <button type="button" class="btn rounded-circle circle-btn"
                            data-action="SelectedPostBgColour" data-colour="aqua" style="background-color : aqua"></button>
                        <button type="button" class="btn rounded-circle circle-btn" 
                            data-action="SelectedPostBgColour" data-colour="black" style="background-color : black"></button>
                        <button type="button" class="btn rounded-circle circle-btn"
                            data-action="SelectedPostBgColour" data-colour="gold" style="background-color : gold"></button>
                        <button class="btn btn-sm text-primary" type="button" data-action="HideColours" id="hideShownColourBtn">_Hide</button>
                    </div>
                    <div class="mb-3" id="imagePreviewContainer" style="display: none; max-height : 220px;">
                        <div class="border rounded p-2 position-relative" style="overflow-y: auto; max-height : 200px;">
                            <input type="hidden" name="pic" id="imagePic">
                            <img id="imagePreview" class="image img-fluid" style="width : 100%; object-fit: contain;" alt="image">
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                                    onclick="clearImage()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <h6 class="mb-3">Add to your post</h6>
                        <div class="d-flex justify-content-around">
                            <label id="labelImageInput" class="btn btn-outline-secondary rounded-pill" title="Photo/Video">
                                <i class="bi bi-image text-success"></i>
                                <span class="ms-1">Photo</span>
                                <input type="file" id="imageInput" name="postImage" accept="image/*" class="d-none">
                            </label>
                            <button type="button" class="btn btn-outline-secondary rounded-pill" title="Tag Friends">
                                <i class="bi bi-person-badge text-primary"></i>
                                <span class="ms-1">Tag People</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-pill" title="Feeling">
                                <i class="bi bi-emoji-smile text-warning"></i>
                                <span class="ms-1">Feeling</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-pill" title="Location">
                                <i class="bi bi-geo-alt text-danger"></i>
                                <span class="ms-1">Location</span>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-secondary" data-action="CancelPostForm">Cancel</button>
                    <button type="submit" id="createPostBtn" class="btn btn-primary action-btn px-4">
                        <i class="bi bi-send me-2"></i>Post
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type= module> 
    import {PostsApiRequest} from '/js/API/PostsApiCalls.js';

    let currentPage = 1;
    let pageSize = 5;
    const loggedInUserName = "@Model.UserName";
    const loggedInLastName = "@Model.LastName";
    const loggedInUserProfile = "@Model.ProfilePicUrl";
    const totalRecords = "@Model.TotalRecords";  

    document.addEventListener("DOMContentLoaded", function () {
        const profileView = document.querySelectorAll('#viewProfile');
        profileView.forEach(element =>{
            element.addEventListener("click", (e) => {
                const userId = e.target.dataset.id;
                const redirectUrl = '@Url.Action("ExternalUserProfile", "Home")';
                window.location.href = `${redirectUrl}/?userId=${userId}`;
            });
        });

        let triggerCounts = 2;
        let loadedRecords = 5;
        let Loading = false;
        const observer = new IntersectionObserver(entries => {           
            if ( !entries[0].isIntersecting || Loading) return;            
            Loading = true;
            if (loadedRecords >= totalRecords)
            {
                observer.disconnect();
                Loading = false;
                return;
            }
            loadPosts(triggerCounts);
            triggerCounts++;
            loadedRecords += 5;
            Loading = false;                      
        });
        observer.observe(document.querySelector("#observer"));      


        const eventListenerClickMethods = 
        {
            async Like(event){
                const postId = event.target.dataset.id;
                const icon = event.target.querySelector("i");
                const likeStatus = icon?.classList.value ?? event?.target.classList.value;               
                if (likeStatus === "bi-hand-thumbs-up") {
                    var results = await fetch(`Home/LikePost?postId=${postId}`, {method : "POST"})
                    if (results.status === 429){
                        const retryTime = parseInt(results.headers.get("Retry-After")) || 15;
                        return rateLimitingError(retryTime);
                    }
                    var res = await results.json();
                    if(res.success)
                    {
                        (icon || event?.target)?.classList.remove("bi-hand-thumbs-up");
                        (icon || event?.target)?.classList.add("bi-hand-thumbs-up-fill");
                        (icon || event?.target)?.style.setProperty("color", "#0d6efd");
                        let totalLikesCount = document.getElementById(`totalLikes-${postId}`);                      
                        if(totalLikesCount){
                            let likesCount = parseInt(totalLikesCount.textContent)
                            totalLikesCount.textContent = likesCount + 1;
                        }else{
                            let displayLikes = document.getElementById(`LikesContainer-${postId}`);
                            displayLikes.innerHTML = ` <span id="totalLikes-${postId}">1</span>  
                                                       <i class="bi bi-heart-fill text-danger me-1"></i>`;
                        }
                    }else{
                        toastr.error("Failed to like");
                    }                   
                }else {
                    var result = await fetch(`Home/UnlikePost?postId=${postId}`, {method: "PUT"});
                    if (result.status === 429){
                        const retryTime = parseInt(result.headers.get("Retry-After")) || 15;
                        return rateLimitingError(retryTime);
                    }
                    var res = await result.json();
                    if(res.success)
                    {
                        (icon || event?.target)?.classList.remove("bi-hand-thumbs-up-fill");
                        (icon || event?.target)?.classList.add("bi-hand-thumbs-up");
                        let totalLikesCount = document.getElementById(`totalLikes-${postId}`);                      
                        if(totalLikesCount){
                            let likesCount = parseInt(totalLikesCount.textContent)
                            totalLikesCount.textContent = likesCount - 1;
                            if(likesCount <= 1){
                                let displayLikes = document.getElementById(`LikesContainer-${postId}`);
                                displayLikes.innerHTML = "";
                            }
                        }
                    }else{
                        toastr.error("Failed to unlike");
                    }                   
                }            
            },

            Share(event)
            {
                const postId = event.target.dataset.id;
                console.log("Like post:", postId);
            },

            async CommentsToggle(event)
            {
                const postId = event.target.dataset.id;
                if (window.innerWidth <= 768 || window.matchMedia("(max-width: 768px)").matches || "ontouchstart" in window || navigator.maxTouchPoints > 0)
                {
                    try
                    {
                        const commentPopUp = document.getElementById(`commentsPopUp-${postId}`);
                        const hideBgContent = document.getElementById(`overlay-${postId}`);
                        commentPopUp.classList.add("show");
                        hideBgContent.style.opacity = "1";
                        hideBgContent.style.pointerEvents = "auto";
                        document.body.style.overflow = "hidden";

                        displayMobileComments(postId);
                        handleCommentsDrag(postId); 
                    }catch(error)
                    {
                        document.getElementById(`displayMobileComments-${postId}`).innerHTML = `
                            <div class="text-center">
                                <i class="bi bi-exclamation-triangle text-danger"></i>
                                <h5>Failed to load more feeds.</h5>
                                <h6>Technical Issue!<br />We currently attending to the issue.</h6>
                                <p class="text-muted mb-2">Please refresh or try again later.</p>
                                <button class="btn btn-primary action-btn" onclick="window.location.reload();">
                                    <i class="bi bi-plus-circle me-2"></i>Refresh
                                </button>
                            </div>`;
                    } 
                }else 
                {  
                    try
                    {
                        const collapseElements = document.getElementById(`commentsContents-${postId}`);
                        if (collapseElements != null) 
                        {
                            const collapseInstances = new bootstrap.Collapse(collapseElements, { toggle: false })
                            const display = document.getElementById(`displayer-${postId}`);
                            var toggleStatus = display.classList.contains("show");
                            if(!toggleStatus)
                            {
                                var result = await PostsApiRequest.getComments(postId, pageSize, currentPage);                                 
                                const res = result.data;
                                const totalCommentsRecords = result.totalRecords;
                                displayComments(postId, res);

                                let triggerCommentsCounts = 2;
                                let loadedComments = 5;
                                let commentsLoading = false; 
                                display.addEventListener("scroll", async () => {
                                    const reachedBottom = display.scrollTop + display.clientHeight >= display.scrollHeight - 10;
                                    if (reachedBottom && !commentsLoading && loadedComments <= totalCommentsRecords) 
                                    {
                                        commentsLoading = true;
                                        loadMoreComments(postId, triggerCommentsCounts);
                                        triggerCommentsCounts++;
                                        loadedComments += 5;
                                    }                                    
                                    if (!reachedBottom) commentsLoading = false;        
                                });                                
                            }else
                            {
                                display.classList.remove("show");
                            }
                            collapseInstances.toggle();
                        }     
                    }catch(error)
                    {
                        const collapseElements = document.getElementById(`commentsContents-${postId}`);
                        if (collapseElements != null) 
                        {
                            const collapseInstances = new bootstrap.Collapse(collapseElements, { toggle: false })
                            const display = document.getElementById(`displayer-${postId}`);
                            var toggleStatus = display.classList.contains("show");
                            if(!toggleStatus)
                            {  
                                document.getElementById(`displayer-${postId}`).innerHTML = `
                                            <div class="text-center">
                                                    <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                                                    <h5>Failed to load more feeds.</h5>
                                                    <h6>Technical Issue!<br />We currently attending to the issue.</h6>
                                                    <p class="text-muted mb-2">Please refresh or try again later. </p>
                                                    <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                                        <i class="bi bi-plus-circle me-2"></i>Refresh
                                                    </button>
                                                </div>`;
                            }else
                            {
                                display.classList.remove("show");
                            }
                            collapseInstances.toggle();
                        }                        
                    }                    
                }
            },

            ToggleCreatePostCard(e){
                document.getElementById("createPostOverlay").classList.toggle("d-none", false);
                document.body.classList.add("no-scroll");
            },

            PostColourBtn(e){
                document.getElementById("colourButton").classList.toggle("d-none", false);
                e.target.style.display = "none";
                document.getElementById("labelImageInput").style.display = 'none';
                document.getElementById("hideShownColourBtn").style.display = "block";
            },

            SelectedPostBgColour(e)
            {
                const color = e.target.dataset.colour;
                var textarea = document.getElementById("textAreaBackground");
                var currentBgColor = textarea.style.backgroundColor;
                if(currentBgColor === color || currentBgColor.trim() === color){
                    textarea.style.backgroundColor = "";
                    document.getElementById("selectedColor").value = "";
                    textarea.style.color = 'black';
                }else{
                    textarea.style.backgroundColor = color;
                    textarea.style.color = 'white';
                    if(color === 'white')
                    textarea.style.color = 'grey';
                    document.getElementById("selectedColor").value = color;
                }
            },

            ToggleClosePostCard(e){
                document.getElementById("createPostOverlay").classList.toggle("d-none", true);
                document.body.classList.remove("no-scroll");
            },

            CancelPostForm(){
                document.getElementById("postForm").reset();
                document.getElementById("imagePreviewContainer").style.display = "none";
                document.getElementById("textAreaBackground").style.backgroundColor = "";
                document.getElementById("selectedColor").value = "";
                document.getElementById("mainButton").style.display = "block";
                document.getElementById("colourButton").classList.toggle("d-none", true);
                document.getElementById("labelImageInput").style.display = 'block';
                document.getElementById("textAreaBackground").style.color = 'black';
                document.getElementById("createPostOverlay").classList.toggle("d-none", true);
                document.body.classList.remove("no-scroll");
            },

            HideColours(e){
