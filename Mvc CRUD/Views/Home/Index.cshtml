    function handleCommentsDrag(postId)
    { 
        const commentPopUp = document.getElementById(`commentsPopUp-${postId}`);
        const hideBgContent = document.getElementById(`overlay-${postId}`);
        let startY = 0;
        let currentY = 0;
        let dragging = false;
        commentPopUp.addEventListener("touchstart", startDrag);
        commentPopUp.addEventListener("mousedown", startDrag);

        function startDrag(e) {
            dragging = true;
            startY = e.touches ? e.touches[0].clientY : e.clientY;
            commentPopUp.style.transition = "none";

            document.addEventListener("touchmove", drag);
            document.addEventListener("mousemove", drag);
            document.addEventListener("touchend", endDrag);
            document.addEventListener("mouseup", endDrag);
        }

        function drag(e) {
            if (!dragging) return;
            currentY = e.touches?.[0]?.clientY ?? e.clientY;
            const diff = currentY - startY;
            if (diff > 0) commentPopUp.style.transform = `translateY(${diff}px)`;
        }

        function endDrag() 
        {
            dragging = false;
            commentPopUp.style.transform = 'translateY(0)';
            if (currentY - startY > 100)
            {
                commentPopUp.classList.remove("show");
                hideBgContent.style.opacity = "0";
                hideBgContent.style.pointerEvents = "none";
                document.body.style.overflow = "";
            }else {
                commentPopUp.classList.add("show");
                hideBgContent.style.opacity = "1";
                hideBgContent.style.pointerEvents = "auto";
                document.body.style.overflow = "hidden";
            }

            document.removeEventListener("touchmove", drag);
            document.removeEventListener("mousemove", drag);
            document.removeEventListener("touchend", endDrag);
            document.removeEventListener("mouseup", endDrag);
        }

        document.getElementById(`dragHandle-${postId}`).addEventListener('click', async function () {
            commentPopUp.classList.remove("show");
            hideBgContent.style.opacity = "0";
            hideBgContent.style.pointerEvents = "none";
            document.body.style.overflow = "";
        });
    }

