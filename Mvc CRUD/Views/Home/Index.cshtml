    let activeToast = "";
    let activeInterval = "";
    function rateLimitingError(retryTime){ 
        if (activeToast) {
            clearInterval(activeInterval);
            toastr.clear(activeToast);
            activeToast = null;
        }
        let remainingSec = retryTime;

        toastr.options = {
            "closeButton": true,
            "positionClass": "toast-top-right",
            "timeOut": "0"
        };

        activeToast = toastr.error(`Too many requests. Try again in ${remainingSec} sec.`); 
        
        activeInterval = setInterval(() => {
            remainingSec--;
            if (remainingSec <= 0) {
                clearInterval(activeInterval);
                activeInterval = "";
                activeToast = "";
                toastr.clear();
                return toastr.success("You can try again now.","",{timeOut: 7000});
            }
            activeToast.find('.toast-message').text(`Too many requests. Try again in ${remainingSec} sec.`);                       
        }, 1000);         
    }

