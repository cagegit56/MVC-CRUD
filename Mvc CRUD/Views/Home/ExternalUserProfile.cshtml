@model Mvc_CRUD.Dto.UserProfileDTO;

@{
    ViewData["Title"] = "UserProfile";
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<link href="~/css/site.css" rel="stylesheet" />

<div class="container py-4">
        <div class="position-relative">
            <div class="dropdown">
                @if (Model.UserCoverPicUrl != null && Model.UserCoverPicUrl?.Length > 0)
                {
                    <button type="button" data-bs-toggle="modal" data-bs-target="#viewCoverPic" style="background:none; border:none; padding:0; cursor:pointer; display:block; width:100%;">
                        <img src="@Model.UserCoverPicUrl" id="coverImage" class="img-fluid w-100" style="height: 450px; object-fit: cover; cursor : pointer;" alt="Cover Image">
                    </button>
                }else
                {
                    <div id="letterCoverImage" class="bg-secondary w-100 text-center" style="height: 400px; align-content : center;">
                        <div class="text-capitalize text-white fw-bolder h1"> @(char.ToUpper(Model.UserName[0]) + Model.UserName.Substring(1)) </div>
                        <div> <small class="text-white h4">Add a Cover Picture</small> </div>
                    </div>                   
                }   
            </div>

            <div class="position-absolute" style="bottom: -70px; left: 30px; z-index : 1;">
                <div class="dropdown">
                    @if (Model.UserProfilePicUrl != null && Model.UserProfilePicUrl.Length > 0)
                    {
                        <button type="button" data-bs-toggle="modal" data-bs-target="#viewProfilePic" style="background:none; border:none; padding:0; cursor:pointer; display:block; width:100%;">
                            <img src="@Model.UserProfilePicUrl" id="profileImage" class="rounded-circle border border-4 border-white update-profile-img"
                                style="width: 150px; height: 150px; object-fit: cover; cursor : pointer" />
                        </button>
                    }else
                    {
                        <div id="letterProfileImage" class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center text-capitalize fw-bolder h2 profile-pic-phone-width'
                                style='width:150px; height:150px; min-width:50px; min-height:50px;'>
                            @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "XX")
                        </div>
                    } 
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between flex-wrap align-items-center">
            <div style="padding-left: 11.5rem">
                <h2 class="fw-bold mb-0">@(char.ToUpper(@Model.UserName[0]) + @Model.UserName.Substring(1)) @(char.ToUpper(@Model.LastName[0]) + @Model.LastName.Substring(1))</h2>
                <small class="text-muted">1,245 Friends</small>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                @if(Model.FriendStatus == true)
                {
                    <button type="submit" id="addFriendBtn" class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-chat-dots-fill"></i> Chat
                    </button>
                    <button type="button" class="btn btn-outline-danger px-3 rounded-pill">
                        <i class="fa-solid fa-user-minus me-1"></i>Unfriend
                    </button>
                }else if(Model.PendingRequest == true)
                {
                    if(Model.RequestSentByMe == true)
                    {
                        <button id="cancelRequestBtn" data-id="@Model.UserId" class="btn btn-primary px-4 rounded-pill">
                            <i class="bi bi-hourglass-split"></i> Cancel Request
                        </button> 
                        <button type="button" id="sendMessageBtn" class="btn btn-light px-4 rounded-pill p-2">Send Message</button>
                    }else{
                        <form id="acceptRequestForm" action="@Url.Action("AcceptRequest", "Home")" enctype="multipart/form-data">
                            <input type="hidden" name="FriendId" value="@Model.UserId" />
                            <input type="hidden" name="FriendName" value="@Model.UserName" />
                            <button type="submit" id="acceptRequestBtn" class="btn btn-primary px-4 rounded-pill">
                                <i class="bi bi-hourglass-split"></i> Accept Request
                            </button>
                        </form> 
                        <button type="button" id="rejectRequestBtn" data-id="@Model.UserId" class="btn btn-outline-danger px-3 rounded-pill">
                            <i class="fa-solid fa-user-minus me-1"></i>Reject request
                        </button>
                    }                                    
                }else {
                    <form id="addFriendForm" action="@Url.Action("SendFriendRequest", "Home")" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="ToUserId" value="@Model.UserId" />
                        <input type="hidden" name="ToUserName" value="@Model.UserName" />
                        <input type="hidden" name="ToUser_LastName" value="@Model.LastName" />
                        <input type="hidden" name="ToUser_ProfilePicUrl" value="@Model.UserProfilePicUrl" />
                        <input type="hidden" name="ToUserEmail" value="@Model.Email" />
                        <button type="submit" id="addFriendBtn" class="btn btn-primary px-4 rounded-pill">
                            <i class="fa-solid fa-user-plus me-1"></i>Add Friend
                        </button>
                    </form> 
                    <button type="button" id="sendMessageBtn" class="btn btn-light px-4 rounded-pill p-2">Send Message</button>
                }   
                <div class="send-msg-menu d-none position-fixed bottom-0 end-0" id="sendMessageMenu">
                    <div class="input group">                      
                         <div class="card shadow-sm border-0 rounded-4 gap-0">
                             <div class="position-relative">
                                 <div class="position-absolute end-0">
                                     <i class="bi bi-globe-central-south-asia clickable" id="minimizeMsgPopUp"></i>
                                     <i class="bi bi-x-lg m-1 clickable" id="closeMsgPopUp"></i>
                                 </div>                                
                             </div>
                                <div class="card-body" id="msgCardSlide">
                                    <div class="d-flex align-items-center mb-2">
                                        @if (!string.IsNullOrEmpty(Model.UserProfilePicUrl))
                                        {
                                            <img src="@Model.UserProfilePicUrl" class="rounded-circle" style="width:45px; height:45px; object-fit: cover; cursor : pointer" />
                                        }
                                        else
                                        {
                                            <div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center'
                                                    style='width:45px; height:45px; font-size: 17px; font-weight: bold;'>
                                                @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "XX")
                                            </div>
                                        }
                                        <div class="col ms-1">
                                            <h6 class="mb-0 fw-bold">
                                                @(char.ToUpper(Model.UserName[0]) + Model.UserName.Substring(1)) @(char.ToUpper(Model.LastName[0]) + Model.LastName.Substring(1)) <i class="bi bi-globe text-muted"></i>
                                            </h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr class="dropdown-divider">
                        <div id="messagesContainer" class="flex-grow-1 overflow-auto bg-light mb-2" style="height: 337px">
                            <div class="text-center text-muted mt-5">No conversations yet.</div>
                        </div>
                        <div class="mt-auto input-group">
                            @if (!string.IsNullOrEmpty(Model.CurrentUserProfilePicUrl))
                            {
                                <img src="@Model.CurrentUserProfilePicUrl" class="rounded-circle me-2 ms-1" style="width: 36px; height: 36px;">
                            }
                            else
                            {
                                <div class="avatar rounded-circle me-2 bg-primary text-white ms-1" style="width: 36px; height: 36px;">
                                    @(!string.IsNullOrEmpty(Model.CurrentUserName) ? Model.CurrentUserName.Substring(0, 1).ToUpper() : "XX")
                                </div>
                            }
                            <input type="text" name="Message" id="sendMessageInput" class="form-control form-control-sm rounded-pill flex-grow-1"
                                   placeholder="Write a message..." autocomplete="off">
                            <button type="button" class="btn btn-primary btn-sm rounded-pill ms-2 px-3">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    </div>

                @* <div class="send-msg-menu d-none position-fixed bottom-0 end-0" id="sendMessageMenu">
                    <div class="position-relative clickable" id="closeMsgPopUp">
                        <i class="bi bi-x-lg position-absolute end-0 m-2"></i>
                    </div>
                    <div class="d-flex flex-column p-3">
                        <div class="card shadow-sm border-0 rounded-4 mt-4 gap-0">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    @if (!string.IsNullOrEmpty(Model.UserProfilePicUrl))
                                    {
                                        <img src="@Model.UserProfilePicUrl" class="rounded-circle" style="width:45px; height:45px; object-fit: cover; cursor : pointer" />
                                    }
                                    else
                                    {
                                        <div class='avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center'
                                             style='width:45px; height:45px; font-size: 17px; font-weight: bold;'>
                                            @(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "XX")
                                        </div>
                                    }
                                    <div class="col ms-1">
                                        <h6 class="mb-0 fw-bold">
                                            @(char.ToUpper(Model.UserName[0]) + Model.UserName.Substring(1)) @(char.ToUpper(Model.LastName[0]) + Model.LastName.Substring(1))
                                        </h6>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr class="dropdown-divider">
                        <div id="messagesContainer" class="flex-grow-1 overflow-auto bg-light mb-2" style="height: 305px">
                            <div class="text-center text-muted mt-5">No conversations yet.</div>
                        </div>
                        <div class="mt-auto input-group">
                            @if (!string.IsNullOrEmpty(Model.CurrentUserProfilePicUrl))
                            {
                                <img src="@Model.CurrentUserProfilePicUrl" class="rounded-circle me-2" style="width: 36px; height: 36px;">
                            }
                            else
                            {
                                <div class="avatar rounded-circle me-2 bg-primary text-white" style="width: 36px; height: 36px;">
                                    @(!string.IsNullOrEmpty(Model.CurrentUserName) ? Model.CurrentUserName.Substring(0, 1).ToUpper() : "XX")
                                </div>
                            }
                            <input type="text" name="Message" id="sendMessageInput" class="form-control form-control-sm rounded-pill flex-grow-1"
                                   placeholder="Write a message..." autocomplete="off">
                            <button type="button" class="btn btn-primary btn-sm rounded-pill ms-2 px-3">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    </div>
                </div> *@
                
            </div>
        </div>
        <hr />
        <ul class="nav nav-tabs mt-3">
            <li class="nav-item">
                <a class="nav-link active" href="#">Posts</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">About</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Friends</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Photos</a>
            </li>
        </ul>

        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold">About</h5>
                        <p class="mt-3 mb-1"><strong>Location:</strong> @Model.Location</p>
                        <p class="mb-1"><strong>Work:</strong> @Model.JobTitle</p>
                        <p class="mb-1"><strong>Education:</strong> @Model.CollegeName</p>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Photos</h5>
                        <div class="row g-2">
                            <div class="col-4">
                                <img src="~/images/cover.png" class="w-100 rounded" />
                            </div>
                            <div class="col-4">
                                <img src="~/images/cover.png" class="w-100 rounded" />
                            </div>
                            <div class="col-4">
                                <img src="~/images/cover.png" class="w-100 rounded" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body text-center text-primary">
                        <h5 class="fw-bold">Posts Feed</h5>
                    </div>
                </div>
                <div id="postContent"></div>
            </div>
        </div>

    </div>

    @* *******************View Profile Picture Pop-up*********************************** *@

    <div class="modal fade" id="viewProfilePic" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Profile Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                    <div class="modal-body">                        
                        <img src="@Model.UserProfilePicUrl" class="post-image img-fluid " alt="Post image"
                             style="height : 450px; width : 500px">
                    </div>
            </div>
        </div>
    </div>

    @* *******************View Cover Picture Pop-up*********************************** *@

    <div class="modal fade" id="viewCoverPic" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Profile Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="height: 470px;">
                    <div class="overflow-auto" style="max-height: 430px;">
                       <img src="@Model.UserCoverPicUrl" class="w-100 rounded" />
                    </div>                    
                </div>
            </div>
        </div>
    </div>


<script>
    const userId = "@Model.UserId";
    const currentUserId = "@Model.CurrentUserId";
    if (userId === currentUserId)
    {
        const redirectUrl = '@Url.Action("UserProfile", "Home")';
        window.location.href = `${redirectUrl}`;
    }
    
    const pageNumber = 1;
    const pageSize = 5;

    document.addEventListener("DOMContentLoaded", function(){

        fetch(`/Home/ExternalUsersPosts/?userId=${userId}&pageSize=${pageSize}&pageNumber=${pageNumber}`, {method: "GET", headers: { "X-Requested-With": "XMLHttpRequest" }  })
       .then( response => {
           return response.json();                        
        }).then( results =>{
            if (results.error) 
                return document.getElementById('postContent').innerHTML =  
                        `<div class="text-center">
                            <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                            <h5>Failed to load more feeds.</h5>
                            <h6>Technical Issue!<br />We currently attending to the issue.</h6>
                            <p class="text-muted mb-2">Please refresh or try again later. </p>
                            <button class="btn btn-primary btn-sm action-btn" onclick="window.location.reload();">
                                <i class="bi bi-plus-circle me-2"></i>Refresh
                            </button>
                         </div>`;
            const res = results.data;
            const content = document.getElementById('postContent');
             if (res.length === 0)
                  return content.innerHTML = ` <div class="alert alert-primary text-center w-100">No Posts Yet.</div>`;
             content.innerHTML = '';
             res.forEach(post => {
                    const firstLetter = post.userName?.charAt(0).toUpperCase() ?? "?";
                    const username = post.userName.charAt(0).toUpperCase() + post.userName.slice(1) + ' ' + post.lastName.charAt(0).toUpperCase() + post.lastName.slice(1);
                    const postInfo  =
                    ` <div class="card shadow-sm border-0 rounded-4 mb-4 gap-0">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                        ${post.userImageUrl ?
                                            `<img src="${post.userImageUrl}" class="rounded-circle" style="width:45px;height:45px;object-fit:cover;" />`
                                                  :  `<div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold" style="width:45px;height:45px;">
                                        ${firstLetter}   </div>` }
                                    <div class="ms-3">
                                        <strong>${username}</strong>
                                        <div class="text-muted small">2 hours ago</div>
                                    </div>
                                </div>
                                ${post.postBgColour ? ` <div class="post-bgcard"  style="background-color:${post.postBgColour};">
                                            <div class="post-bgtext">${post.content}</div>
                                            </div>` : `${post.content}`}
                                ${post.imageContentUrl ? `<img src="${post.imageContentUrl}" class="w-100 rounded mb-3" />` : ''}
                                <div class="d-flex justify-content-around">
                                    <button class="btn btn-light w-100 me-2"><i class="bi bi-hand-thumbs-up"></i> Like</button>
                                    <button class="btn btn-light w-100 me-2"><i class="bi bi-chat"></i> Comment</button>
                                    <button class="btn btn-light w-100"><i class="bi bi-share"></i> Share</button>
                                </div>
                            </div>
                        </div>`;
                    content.insertAdjacentHTML('beforeend', postInfo);
             });
        }); 
    }); 

    const sendMsg = document.getElementById("sendMessageBtn");
    if (sendMsg)
    {
        const menu = document.getElementById("sendMessageMenu");
        sendMsg.addEventListener("click", e => {
            e.stopPropagation();      
            menu.classList.contains("d-none") ? menu.classList.remove("d-none") : menu.classList.add("d-none");
            const input = document.getElementById("sendMessageInput");
            input.focus();           
        });

         // document.addEventListener("click", () => {
         //     menu.style.display = "none";
         // });
    }

    const closeBtn = document.getElementById("closeMsgPopUp");
    if (closeBtn)
    {
        closeBtn.addEventListener("click", e => {
            document.getElementById("sendMessageMenu").classList.add("d-none");
        });        
    }  
    
    const minimizeMsgCard = document.getElementById("minimizeMsgPopUp");
    if (minimizeMsgCard)
    {
        minimizeMsgCard.addEventListener("click", e => {
            document.getElementById("sendMessageMenu").style.height = "90px";
        });
    }

    const msgSlideDirection = document.getElementById("msgCardSlide");
    if (msgSlideDirection)
    {
        msgSlideDirection.addEventListener("click", e => {
            document.getElementById("sendMessageMenu").style.height = "350px";
        });
    }

    const cancelRequest = document.getElementById("cancelRequestBtn");
    if (cancelRequest)
    {
        cancelRequest.addEventListener("click", async (e) =>{
            const userId = e.target.dataset.id;
            const results = await fetch(`/Home/RejectRequest?friendUserId=${userId}`, { method: "PUT"} );
            const res = await results.json();
            if (res.success)
            {
                toastr.success("Request successfully cancelled.")
                cancelRequest.disabled = true;
            }else {
                toastr.error("Failed to cancel friend request.")
            }
        });        
    }

    const rejectRequest = document.getElementById("rejectRequestBtn");
    if (rejectRequest) 
    {
        rejectRequest.addEventListener("click", async (e) => {
            const userId = e.target.dataset.id;
            const results = await fetch(`/Home/RejectRequest?friendUserId=${userId}`, { method: "PUT" });
            const res = await results.json();
            if (res.success) {
                toastr.success("Request successfully rejected.")
                rejectRequest.disabled = true;
                document.getElementById("acceptRequestBtn").disabled = true;
            } else {
                toastr.error("Failed to reject friend request.")
            }
        });
    }


    const addFriendForm = document.getElementById("addFriendForm");
    if (addFriendForm)
    {
        addFriendForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const form = e.target;
            try
            {
                const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
                if(res.ok)
                { 
                    document.getElementById("addFriendBtn").disabled = true;
                    toastr.success("Friend Request SuccessFully sent.");
                }else { 
                    toastr.error("Failed to send request.");
                }
            }catch(error){
                toastr.error("Failed to send request, Please try again later.");
            }
        });
    }

    const acceptRequestForm = document.getElementById("acceptRequestForm");
    if (acceptRequestForm)
    {
        acceptRequestForm.addEventListener("submit", async (e) =>{
            e.preventDefault();
            const form = e.target;
            const res = await fetch(form.action, { method: "POST", body: new FormData(form) } );
            if (res.ok){
                toastr.success("Successfully Accepted.");
                document.getElementById("acceptRequestBtn").disabled = true;
                document.getElementById("rejectRequestBtn").disabled = true;
            }else{
                toastr.error("Failed to accept request.");
            }
        });
    }    
    
</script>




